  border: 0.5rpx solid rgba(110, 110, 115, 0.18);
}
.geo-pref-empty .geo-pref-note-text { color: #6E6E73; }

.school-card-list { display: flex; flex-direction: column; gap: 16rpx; }

.school-rec-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  border: 0.5rpx solid rgba(0, 0, 0, 0.07);
  border-top-color: rgba(255, 255, 255, 0.98);
  padding: 28rpx 28rpx 22rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}
