  flex: 1;
  min-width: 200rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  border: 1rpx solid #D1DDF6;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pred-card-type {
  font-size: 22rpx;
  color: #6B7280;
  margin-bottom: 8rpx;
}
.pred-card-score {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A3A8F;
  line-height: 1.1;
}
.pred-card-range {
  font-size: 20rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
}
.pred-card-trend {
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.pred-card-trend.rising  { color: #DC2626; background: #FEE2E2; }
.pred-card-trend.stable  { color: #6B7280; background: #F3F4F6; }
.pred-card-trend.falling { color: #2563EB; background: #EFF6FF; }

/* ══════════════════════════════════════════════════════
   招生政策区块
══════════════════════════════════════════════════════ */
.policy-section {
  margin: 24rpx 0;
}
.policy-header {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-bottom: 20rpx;
}
.policy-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-right: 16rpx;
}
.policy-disclaimer {
  font-size: 20rpx;
  color: #9CA3AF;
}

/* ── 政策卡片 ── */
.policy-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.policy-card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
  gap: 10rpx;
}
.policy-card-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}
.policy-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  flex: 1;
}
.policy-card-body {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.7;
}

/* ── 政策徽章 ── */
.policy-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}
/* 转专业难度色彩 */
.transfer-free     { background: #D1FAE5; color: #065F46; }
.transfer-easy     { background: #D1FAE5; color: #065F46; }
.transfer-medium   { background: #FEF3C7; color: #92400E; }
.transfer-hard     { background: #FEE2E2; color: #991B1B; }
.transfer-restricted { background: #F3F4F6; color: #374151; }
/* 大类招生 */
.broad-full    { background: #DBEAFE; color: #1E40AF; }
.broad-partial { background: #EDE9FE; color: #5B21B6; }
.broad-major   { background: #F3F4F6; color: #374151; }
/* 强基 */
.qiangji-yes { background: #D1FAE5; color: #065F46; }
.qiangji-no  { background: #F3F4F6; color: #6B7280; }

/* ── 提示条 ── */
.policy-tip {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-top: 14rpx;
  background: #FFFBEB;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  border-left: 4rpx solid #F59E0B;
}
.policy-tip-icon { font-size: 26rpx; margin-right: 10rpx; flex-shrink: 0; }
.policy-tip-text { font-size: 24rpx; color: #78350F; line-height: 1.6; }

/* ── 分流时间 ── */
.policy-split-timing {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 14rpx;
  background: #F0F9FF;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
}
.timing-icon { font-size: 24rpx; margin-right: 8rpx; }
.timing-text { font-size: 24rpx; color: #0369A1; }

/* ── 强基专业标签 ── */
.qiangji-majors {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}
.qiangji-major-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: #EFF6FF;
  color: #1D4ED8;
  border-radius: 20rpx;
  border: 1rpx solid #BFDBFE;
}

/* ── 强基入围参考分 ── */
.qiangji-ref-score {
  margin-top: 16rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.ref-score-label {
  font-size: 22rpx;
  color: #6B7280;
  display: block;
  margin-bottom: 10rpx;
}
.ref-score-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 6rpx 0;
  border-bottom: 1rpx solid #E5E7EB;
}
.ref-score-row:last-child { border-bottom: none; }
.ref-score-province { font-size: 24rpx; color: #374151; }
.ref-score-val { font-size: 24rpx; font-weight: 600; color: #1D4ED8; }

/* ── 保研/深造统计条 ── */
.postgrad-stats {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: linear-gradient(135deg, #EFF6FF 0%, #F0FDF4 100%);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.postgrad-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.postgrad-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1E40AF;
}
.postgrad-label {
  font-size: 20rpx;
  color: #6B7280;
  margin-top: 4rpx;
}
.postgrad-divider {
  width: 1rpx;
  height: 60rpx;
  background: #D1D5DB;
}

/* ── Phase 1-B: 中国学生视角 ─────────────────────────────── */
.cn-student-section {
  background: #F5F5F7;
  margin: 0 0 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
}

.cn-student-header {
  margin-bottom: 20rpx;
}

.cn-student-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.3rpx;
}

.cn-student-sub {
  display: block;
  font-size: 22rpx;
  color: #86868B;
  margin-top: 4rpx;
}

.cn-info-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border: 0.5rpx solid rgba(0,0,0,0.06);
}

.cn-info-card:last-child {
  margin-bottom: 0;
}

.cn-info-stem {
  background: linear-gradient(135deg, #EFF6FF 0%, #F5F3FF 100%);
  border-color: rgba(99,102,241,0.15);
}

.cn-info-cost4yr {
  background: linear-gradient(135deg, #FFFBEB 0%, #FFF7F0 100%);
  border-color: rgba(251,191,36,0.2);
}

.cn-info-head {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.cn-info-icon {
  font-size: 36rpx;
  line-height: 1;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.cn-info-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1D1D1F;
  line-height: 1.3;
  margin-bottom: 6rpx;
}

.cn-info-body {
  display: block;
  font-size: 22rpx;
  color: #6E6E73;
  line-height: 1.6;
}

/* 就业方向标签 */
.cn-career-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.cn-career-tag {
  font-size: 22rpx;
  color: #0071E3;
  background: rgba(0,113,227,0.08);
  border-radius: 980rpx;
  padding: 6rpx 18rpx;
  font-weight: 500;
}

/* ── Phase 1-C: 快速适配度检测 ──────────────────────────── */
.fit-check-section {
  background: #FFFFFF;
  margin: 0 0 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  border: 0.5rpx solid rgba(0,0,0,0.05);
}

.fit-check-header {
  margin-bottom: 20rpx;
}

.fit-check-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.3rpx;
}

.fit-check-sub {
  display: block;
  font-size: 22rpx;
  color: #86868B;
  margin-top: 4rpx;
}

.fit-row {
  margin-bottom: 16rpx;
}

.fit-row-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #3C3C43;
  margin-bottom: 10rpx;
}

.fit-scroll { width: 100%; }

.fit-band-row {
  display: flex;
  gap: 8rpx;
  padding-bottom: 4rpx;
  white-space: nowrap;
}

.fit-band-chip {
  display: inline-flex;
  padding: 10rpx 24rpx;
  border-radius: 980rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #3C3C43;
  background: #F5F5F7;
  flex-shrink: 0;
  letter-spacing: 0.2rpx;
}

.fit-chip-active {
  background: #1D1D1F;
  color: #FFFFFF;
}

.fit-result {
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1.5rpx solid;
  margin-top: 8rpx;
}

.fit-result-top {
  margin-bottom: 8rpx;
}

.fit-result-tier {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: -0.3rpx;
}

.fit-result-reason {
  display: block;
  font-size: 24rpx;
  color: #3C3C43;
  line-height: 1.5;
}

.fit-result-cta {
  margin-top: 14rpx;
  padding: 12rpx 0 0;
  border-top: 1rpx solid rgba(0,0,0,0.08);
}

.fit-cta-text {
  font-size: 24rpx;
  color: #0071E3;
  font-weight: 600;
}

.fit-hint {
  text-align: center;
  padding: 20rpx 0 8rpx;
}

.fit-hint-text {
  font-size: 24rpx;
  color: #AEAEB2;
}

/* ── Phase 1-D: 收藏按钮 ─────────────────────────────────── */
.header-fav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  flex-shrink: 0;
  margin-top: -4rpx;
}

.header-fav-icon {
  font-size: 36rpx;
  line-height: 1;
}

/* ── Phase 2: 报告入口 banner ───────────────────────────── */
.report-cta-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #1D1D1F 0%, #3C3C3E 100%);
  margin: 0 0 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
}

.report-cta-banner:active { opacity: 0.85; }

.report-cta-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.report-cta-icon { font-size: 44rpx; }

.report-cta-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.report-cta-sub {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 4rpx;
}

.report-cta-price {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.report-cta-price-label {
  font-size: 32rpx;
  font-weight: 800;
  color: #FFD60A;
}

.report-cta-arrow {
  font-size: 40rpx;
  color: rgba(255,255,255,0.4);
  font-weight: 200;
  line-height: 1;
}

/* ── Phase 3: 截止日期 & 奖学金提示 ─────────────────────── */
.cn-info-deadline {
  background: linear-gradient(135deg, #F0FFF4 0%, #F5F3FF 100%);
  border-color: rgba(52,199,89,0.15);
}

.deadline-extra-row {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.deadline-chip {
  font-size: 20rpx;
  font-weight: 500;
  padding: 5rpx 14rpx;
  border-radius: 980rpx;
}

.chip-green {
  color: #34C759;
  background: rgba(52,199,89,0.1);
}

.chip-blue {
  color: #0071E3;
  background: rgba(0,113,227,0.08);
}

.chip-gray {
  color: #86868B;
  background: rgba(0,0,0,0.05);
}

/* ══════════════════════════════════════════════════════════════════
   P5 专业上下文（Program Context Section）
   ══════════════════════════════════════════════════════════════════ */
.program-ctx-section {
  margin: 24rpx 32rpx;
  background: linear-gradient(135deg, #F0F4FF 0%, #EFF8FF 100%);
  border-radius: 20rpx; padding: 28rpx;
  border: 1rpx solid rgba(0,113,227,0.18);
}
.program-ctx-header {
  display: flex; flex-direction: row; align-items: center;
  gap: 16rpx; margin-bottom: 24rpx;
}
.program-ctx-icon { font-size: 36rpx; }
.program-ctx-title-col { display: flex; flex-direction: column; gap: 4rpx; }
.program-ctx-title { font-size: 28rpx; font-weight: 700; color: #1D1D1F; }
.program-ctx-sub { font-size: 22rpx; color: #6E6E73; }
.program-ctx-grid {
  display: flex; flex-direction: row; flex-wrap: wrap; gap: 16rpx;
  margin-bottom: 16rpx;
}
.program-ctx-item {
  background: #FFFFFF; border-radius: 14rpx;
  padding: 18rpx 22rpx; min-width: 140rpx;
  border: 1rpx solid rgba(0,113,227,0.1);
  display: flex; flex-direction: column; gap: 4rpx;
}
.pci-value { font-size: 32rpx; font-weight: 800; color: #0071E3; letter-spacing: -0.02em; }
.pci-value-gray { color: #6E6E73; }
.pci-tier-1 { color: #C4A35A; }
.pci-tier-2 { color: #0071E3; }
.pci-tier-3 { color: #34C759; }
.pci-label { font-size: 20rpx; color: #AEAEB2; }
.pci-vs { margin-top: 4rpx; }
.pci-vs-text { font-size: 20rpx; font-weight: 600; }
.pci-vs-high { color: #1A8038; }
.pci-vs-low  { color: #FF3B30; }
.pci-vs-mid  { color: #6E6E73; }
.program-ctx-note { display: block; font-size: 20rpx; color: #AEAEB2; line-height: 1.5; }
