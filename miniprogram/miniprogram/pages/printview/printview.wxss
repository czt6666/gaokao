/* printview.wxss — 袁希™ 报告文档视图 */
/* Apple Light Design Language: F5F5F7 bg · #FFF card · C4A35A gold */

page { background: #1A1A1F; }

.scroll-root { min-height: 100vh; background: #F5F5F7; padding-bottom: 100rpx; }

/* ── Hero ─────────────────────────────────────────────────── */
.hero {
  background: linear-gradient(180deg, #1A1A1F 0%, #26262C 100%);
  padding: 64rpx 40rpx 56rpx;
  text-align: center;
}
.avatar {
  width: 112rpx; height: 112rpx; border-radius: 56rpx;
  background: rgba(196,163,90,.1);
  border: 2rpx solid rgba(196,163,90,.35);
  margin: 0 auto 28rpx;
  display: flex; align-items: center; justify-content: center;
}
.avatar-text {
  font-size: 44rpx; font-weight: 700; color: #C4A35A; line-height: 1;
}
.h-name {
  font-size: 40rpx; font-weight: 700; color: #F5F5F7;
  letter-spacing: -0.01em; display: block;
}
.h-meta {
  font-size: 24rpx; color: rgba(245,245,247,.5);
  margin-top: 8rpx; display: block;
}
.h-score {
  font-size: 136rpx; font-weight: 800; line-height: 1;
  margin: 44rpx 0 6rpx; display: block;
}
.h-score-lbl {
  font-size: 24rpx; color: rgba(245,245,247,.55); display: block;
}
.h-path {
  display: inline-block; margin-top: 28rpx;
  padding: 12rpx 36rpx;
  background: rgba(196,163,90,.1);
  border: 1rpx solid rgba(196,163,90,.35);
  border-radius: 40rpx;
}
.h-path-text { font-size: 26rpx; color: #C4A35A; }

/* ── Section card ──────────────────────────────────────────── */
.sec {
  background: #FFFFFF; border-radius: 24rpx;
  margin: 24rpx 24rpx 0; overflow: hidden;
}
.sec-hd {
  display: flex; align-items: center; gap: 16rpx;
  padding: 32rpx 32rpx 28rpx;
  border-bottom: 1rpx solid rgba(0,0,0,.07);
}
.sec-num {
  font-size: 18rpx; font-weight: 800; color: #C4A35A;
  letter-spacing: .08em; text-transform: uppercase;
}
.sec-title { font-size: 32rpx; font-weight: 700; color: #1D1D1F; }
.sec-badge {
  margin-left: auto; padding: 4rpx 16rpx;
  background: rgba(0,113,227,.08); border-radius: 12rpx;
}
.sec-badge-text { font-size: 20rpx; color: #0071E3; }
.sec-bd { padding: 24rpx 32rpx 32rpx; }

/* ── Dimension bars ─────────────────────────────────────────── */
.dim-row { margin-bottom: 28rpx; }
.dim-row:last-child { margin-bottom: 0; }
.dim-hd { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12rpx; }
.dim-lbl { font-size: 26rpx; color: #6E6E73; }
.dim-sc  { font-size: 24rpx; font-weight: 600; }
.bar-bg  { height: 8rpx; background: rgba(0,0,0,.06); border-radius: 4rpx; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 4rpx; }

/* ── AI Plan text ──────────────────────────────────────────── */
.ai-text {
  font-size: 26rpx; color: #6E6E73; line-height: 1.85;
  white-space: pre-wrap; word-break: break-all; display: block;
}

/* ── Path rationale ────────────────────────────────────────── */
.rat-item {
  font-size: 26rpx; color: #6E6E73; line-height: 1.75;
  margin-bottom: 14rpx; display: block;
}

/* ── School cards (AI推荐 + USA匹配 共用) ──────────────────── */
.tier-hd {
  padding: 24rpx 32rpx 6rpx;
  font-size: 20rpx; font-weight: 800;
  letter-spacing: .08em; text-transform: uppercase;
}
.sch-list { padding: 0 32rpx; }
.sch-card {
  padding: 28rpx 0;
  border-top: 1rpx solid rgba(0,0,0,.07);
}
.sch-card:first-child { border-top: none; }
.sch-row { display: flex; justify-content: space-between; align-items: flex-start; }
.sch-left { flex: 1; margin-right: 20rpx; }
.sch-name { font-size: 28rpx; font-weight: 600; color: #1D1D1F; display: block; }
.sch-loc  { font-size: 22rpx; color: #AEAEB2; margin-top: 4rpx; display: block; }
.sch-right { text-align: right; min-width: 80rpx; }
.sch-score { font-size: 44rpx; font-weight: 700; line-height: 1; display: block; }
.sch-slbl  { font-size: 18rpx; color: #AEAEB2; }
.sch-stats { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 14rpx; }
.stat      { font-size: 22rpx; color: #AEAEB2; }
.sch-insight { font-size: 24rpx; color: #6E6E73; margin-top: 12rpx; line-height: 1.7; display: block; }
/* AI school type/match tag */
.sch-tag {
  display: inline-block; margin-top: 8rpx; margin-right: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx; font-size: 20rpx;
}
.sch-reason { font-size: 24rpx; color: #6E6E73; margin-top: 12rpx; line-height: 1.7; display: block; }

/* ── Action steps ────────────────────────────────────────────── */
.act-item {
  display: flex; gap: 22rpx; padding: 26rpx 0;
  border-top: 1rpx solid rgba(0,0,0,.07);
}
.act-item:first-child { border-top: none; }
.act-circle {
  width: 44rpx; height: 44rpx; min-width: 44rpx; border-radius: 22rpx;
  border: 2rpx solid rgba(196,163,90,.35);
  display: flex; align-items: center; justify-content: center;
  margin-top: 2rpx;
}
.act-num { font-size: 22rpx; font-weight: 700; color: #C4A35A; }
.act-body { flex: 1; }
.act-title { font-size: 28rpx; font-weight: 600; color: #1D1D1F; display: block; }
.act-time  { font-size: 22rpx; color: #C4A35A; margin-top: 4rpx; display: block; }
.act-desc  { font-size: 24rpx; color: #6E6E73; margin-top: 8rpx; line-height: 1.7; display: block; }

/* ── Bottom action bar ──────────────────────────────────────── */
.action-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: rgba(255,255,255,.92);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(0,0,0,.08);
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex; gap: 20rpx;
}
.btn-share {
  flex: 1; height: 88rpx; border-radius: 22rpx;
  background: #0071E3;
  display: flex; align-items: center; justify-content: center;
}
.btn-share-text { font-size: 28rpx; font-weight: 600; color: #fff; }
.btn-image {
  flex: 0 0 auto; height: 88rpx; padding: 0 32rpx; border-radius: 22rpx;
  background: rgba(0,0,0,.06);
  display: flex; align-items: center; justify-content: center;
}
.btn-image-text { font-size: 26rpx; color: #6E6E73; }

/* ── Footer ───────────────────────────────────────────────────── */
.footer { text-align: center; padding: 64rpx 40rpx 40rpx; }
.ftr-logo { font-size: 30rpx; font-weight: 700; color: #C4A35A; display: block; }
.ftr-sub  { font-size: 22rpx; color: #AEAEB2; margin-top: 8rpx; display: block; }
.ftr-date { font-size: 20rpx; color: rgba(0,0,0,.2); margin-top: 24rpx; display: block; }
