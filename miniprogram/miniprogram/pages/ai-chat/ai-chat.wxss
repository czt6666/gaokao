/* pages/ai-chat/ai-chat.wxss */
/* 袁希™ · 2026 Liquid Glass — AI成长诊断室 */
/* ═══════════════════════════════════════════════════════════
   Design Tokens  (iOS 26 / Apple Vision Pro 风格)
   背景    : linear-gradient(160deg, #F8F6FF → #EEF2FB → #E8EEFF)
   玻璃    : rgba(255,255,255,0.72) + blur(40px) + saturate(180%)
   AI 文字 : #1A1A2E  深蓝黑
   用户文字: rgba(255,255,255,0.96)
   强调色  : #5B4FCF  品牌紫（2026）
   金色    : #C4A35A  点睛
   边框    : rgba(255,255,255,0.65) 上高光 / rgba(0,0,0,0.06) 下轮廓
   ═══════════════════════════════════════════════════════════ */

/* ── 页面画布：浅紫白渐变 ─────────────────────────────── */
page {
  background: linear-gradient(160deg, #F8F6FF 0%, #EEF2FB 50%, #E8EEFF 100%);
  min-height: 100vh;
}

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: transparent;
  box-sizing: border-box;
}

/* ══════════════════════════════════════════════
   顶部进度区 — 白色磨砂导航条
══════════════════════════════════════════════ */
.progress-bar-wrap {
  padding: 20rpx 36rpx 16rpx;
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(48px) saturate(180%);
  -webkit-backdrop-filter: blur(48px) saturate(180%);
  border-bottom: 0.5rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: inset 0 -0.5rpx 0 rgba(255,255,255,0.90),
              0 1rpx 12rpx rgba(91, 79, 207, 0.05);
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

/* 极细品牌紫进度轨道 */
.progress-track {
  height: 2rpx;
  background: rgba(0, 0, 0, 0.07);
  border-radius: 2rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5B4FCF 0%, #8B7FE8 60%, #C4A35A 100%);
  border-radius: 2rpx;
  transition: width 0.65s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 阶段标签：品牌紫玻璃胶囊 */
.stage-pill {
  display: inline-block;
  padding: 5rpx 18rpx;
  background: rgba(91, 79, 207, 0.07);
  border-radius: 980rpx;
  border: 0.5rpx solid rgba(91, 79, 207, 0.14);
  font-size: 21rpx;
  font-weight: 600;
  color: #5B4FCF;
  letter-spacing: 0.5rpx;
  align-self: flex-start;
}

/* ══════════════════════════════════════════════
   Followup / Consult 顶部标识条
══════════════════════════════════════════════ */
.followup-context-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(40px) saturate(160%);
  -webkit-backdrop-filter: blur(40px) saturate(160%);
  border-bottom: 0.5rpx solid rgba(91, 79, 207, 0.12);
  padding: 20rpx 28rpx;
  flex-shrink: 0;
}

.fcb-icon { font-size: 28rpx; flex-shrink: 0; }
.fcb-text { flex: 1; }

.fcb-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A2E;
  line-height: 1.3;
}

.fcb-sub {
  display: block;
  font-size: 21rpx;
  color: #8E8EA0;
  margin-top: 3rpx;
}

.fcb-back {
  font-size: 22rpx;
  color: #5B4FCF;
  font-weight: 600;
  padding: 10rpx 20rpx;
  background: rgba(91, 79, 207, 0.08);
  border: 0.5rpx solid rgba(91, 79, 207, 0.18);
  border-radius: 980rpx;
  flex-shrink: 0;
}

.consult-bar {
  background: rgba(255, 255, 255, 0.68);
  border-bottom-color: rgba(0, 0, 0, 0.07);
}

/* ══════════════════════════════════════════════
   滚动区 — 透明，让渐变背景透出
══════════════════════════════════════════════ */
.chat-scroll {
  flex: 1;
  overflow: hidden;
  background: transparent;
}

.chat-inner {
  padding: 40rpx 28rpx 0;
}

/* ══════════════════════════════════════════════
   消息行
══════════════════════════════════════════════ */
.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.row-left  { flex-direction: row; }
.row-right { flex-direction: row-reverse; }

/* ══════════════════════════════════════════════
   AI头像：金色✦符号（无圆形背景）
══════════════════════════════════════════════ */
.ai-avatar {
  width: 40rpx;
  flex-shrink: 0;
  padding-top: 12rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.avatar-symbol {
  font-size: 28rpx;
  color: #C4A35A;
  line-height: 1;
}

/* ══════════════════════════════════════════════
   气泡 — 2026 Liquid Glass
══════════════════════════════════════════════ */
.bubble-stack {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
}
.bubble-stack-right { align-items: flex-end; }

.bubble { max-width: 100%; }

/* AI气泡：白色磨砂玻璃卡片，无边角 */
.bubble-ai {
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border-radius: 6rpx 24rpx 24rpx 24rpx;
  border: 0.5rpx solid rgba(255, 255, 255, 0.90);
  border-top-color: rgba(255, 255, 255, 0.98);
  box-shadow: 0 2rpx 20rpx rgba(91, 79, 207, 0.08),
              0 0.5rpx 2rpx rgba(0, 0, 0, 0.04),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  padding: 22rpx 28rpx;
}

/* 用户气泡：品牌紫实色 */
.bubble-user {
  background: linear-gradient(135deg, #5B4FCF, #7B6FE0);
  border-radius: 24rpx 6rpx 24rpx 24rpx;
  border: none;
  box-shadow: 0 4rpx 18rpx rgba(91, 79, 207, 0.30),
              0 1rpx 4rpx rgba(91, 79, 207, 0.18);
  padding: 18rpx 26rpx;
  max-width: 72vw;
}

.bubble-text {
  white-space: pre-wrap;
  word-break: break-word;
}

.bubble-ai   .bubble-text {
  font-size: 32rpx;
  line-height: 1.82;
  color: #1A1A2E;
  font-weight: 400;
}
.bubble-user .bubble-text {
  font-size: 30rpx;
  line-height: 1.65;
  color: rgba(255, 255, 255, 0.96);
}

/* ══════════════════════════════════════════════
   问题高亮块：品牌紫左边框
══════════════════════════════════════════════ */
.question-highlight {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg,
    rgba(91, 79, 207, 0.06) 0%,
    rgba(91, 79, 207, 0.03) 100%);
  border-radius: 16rpx;
  border-left: 4rpx solid #5B4FCF;
  position: relative;
}
.question-highlight::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 16rpx;
  border: 0.5rpx solid rgba(91, 79, 207, 0.16);
  pointer-events: none;
}

.question-highlight-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A2E;
  line-height: 1.58;
  letter-spacing: 0.3rpx;
  display: block;
}

/* ══════════════════════════════════════════════
   打字动画 — 品牌紫三点
══════════════════════════════════════════════ */
.typing-bubble {
  min-width: 120rpx;
  animation: bubbleGlow 2.4s ease-in-out infinite;
}

@keyframes bubbleGlow {
  0%, 100% { box-shadow: 0 2rpx 16rpx rgba(91, 79, 207, 0.08); }
  50%       { box-shadow: 0 4rpx 28rpx rgba(91, 79, 207, 0.20); }
}

.typing-label {
  display: block;
  font-size: 22rpx;
  color: #5B4FCF;
  font-weight: 600;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.typing-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 2rpx 0;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #5B4FCF;
}

.dot1 { animation: dotPulse 1.3s 0s    infinite ease-in-out; }
.dot2 { animation: dotPulse 1.3s 0.20s infinite ease-in-out; }
.dot3 { animation: dotPulse 1.3s 0.40s infinite ease-in-out; }

@keyframes dotPulse {
  0%, 60%, 100% { opacity: 0.20; transform: scale(0.65); }
  30%           { opacity: 1;    transform: scale(1.25); }
}

/* ══════════════════════════════════════════════
   AI深度分析卡片 — 浮动玻璃面板
══════════════════════════════════════════════ */
.analysis-card {
  background: rgba(255, 255, 255, 0.84);
  backdrop-filter: blur(60px) saturate(200%);
  -webkit-backdrop-filter: blur(60px) saturate(200%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx 30rpx;
  margin: 8rpx 0 20rpx;
  border: 0.5rpx solid rgba(255, 255, 255, 0.96);
  border-top-color: rgba(255, 255, 255, 0.98);
  box-shadow: 0 8rpx 48rpx rgba(91, 79, 207, 0.12),
              0 2rpx 8rpx rgba(0, 0, 0, 0.05),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  position: relative;
  overflow: hidden;
}

/* 顶部紫色光晕 */
.analysis-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 360rpx;
  height: 200rpx;
  background: radial-gradient(ellipse, rgba(91, 79, 207, 0.08) 0%, transparent 70%);
  pointer-events: none;
}

.ac-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.ac-avatar-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.ac-avatar-pulse {
  position: absolute;
  top: 0; left: 0;
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: rgba(91, 79, 207, 0.12);
  animation: avatarPulse 2s ease-in-out infinite;
}

@keyframes avatarPulse {
  0%, 100% { transform: scale(1);    opacity: 0.8; }
  50%       { transform: scale(1.30); opacity: 0; }
}

.ac-avatar {
  position: absolute;
  top: 6rpx; left: 6rpx;
  width: 60rpx; height: 60rpx;
  border-radius: 50%;
  background: rgba(91, 79, 207, 0.10);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 0.5rpx solid rgba(91, 79, 207, 0.20);
  border-top-color: rgba(255, 255, 255, 0.95);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 10rpx rgba(91, 79, 207, 0.14),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

.ac-avatar-char {
  font-size: 24rpx;
  font-weight: 700;
  color: #5B4FCF;
}

.ac-header-info { flex: 1; }

.ac-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 6rpx;
}

.ac-subtitle {
  display: block;
  font-size: 23rpx;
  color: #8E8EA0;
  line-height: 1.5;
  min-height: 35rpx;
}

/* Shimmer进度条 — 紫→金渐变 */
.ac-shimmer-wrap {
  height: 2rpx;
  background: rgba(0, 0, 0, 0.06);
  border-radius: 2rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  position: relative;
}

.ac-shimmer-bar {
  height: 100%;
  width: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    #5B4FCF 25%,
    #C4A35A 50%,
    #5B4FCF 75%,
    transparent 100%
  );
  background-size: 200% 100%;
  border-radius: 2rpx;
  animation: shimmerMove 1.8s linear infinite;
}

@keyframes shimmerMove {
  0%   { background-position: 200% center; }
  100% { background-position: -200% center; }
}

/* 四步进度网格 */
.ac-steps-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 26rpx;
}

.ac-step {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: calc(50% - 7rpx);
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  transition: all 0.4s ease;
}

.ac-step-pending {
  background: rgba(0, 0, 0, 0.03);
  border: 0.5rpx solid rgba(0, 0, 0, 0.06);
}

.ac-step-done {
  background: rgba(91, 79, 207, 0.06);
  border: 0.5rpx solid rgba(91, 79, 207, 0.16);
}

.ac-step-icon {
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.ac-step-pending .ac-step-icon { color: #C7C7CC; }
.ac-step-done    .ac-step-icon { color: #5B4FCF; }

.ac-step-label { font-size: 23rpx; font-weight: 500; }
.ac-step-pending .ac-step-label { color: #AEAEB2; }
.ac-step-done    .ac-step-label { color: #1A1A2E; }

.ac-footer {
  display: block;
  text-align: center;
  font-size: 19rpx;
  color: rgba(0, 0, 0, 0.16);
  letter-spacing: 1.5rpx;
}

/* ══════════════════════════════════════════════
   选项区 — 全宽纵向 Liquid Glass 选项块
══════════════════════════════════════════════ */
.options-bar {
  padding: 14rpx 24rpx 16rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border-top: 0.5rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 -1rpx 0 rgba(255,255,255,0.90),
              0 -4rpx 20rpx rgba(91, 79, 207, 0.05);
}

.options-inner {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

/* 全宽 Liquid Glass 选项块 */
.option-tile {
  width: 100%;
  padding: 22rpx 28rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 0.5rpx solid rgba(255, 255, 255, 0.90);
  border-left: 3rpx solid rgba(91, 79, 207, 0.40);
  border-top-color: rgba(255, 255, 255, 0.98);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A2E;
  box-sizing: border-box;
  line-height: 1.55;
  box-shadow: 0 1rpx 8rpx rgba(0, 0, 0, 0.05),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
}

.option-tile:active {
  background: rgba(91, 79, 207, 0.07);
  border-left-color: #5B4FCF;
  color: #3D34A8;
  transform: scale(0.985);
}

/* ══════════════════════════════════════════════
   输入栏 — 白色磨砂底部面板
══════════════════════════════════════════════ */
.input-bar {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  padding: 14rpx 20rpx 22rpx;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(48px) saturate(200%);
  -webkit-backdrop-filter: blur(48px) saturate(200%);
  border-top: 0.5rpx solid rgba(255, 255, 255, 0.94);
  box-shadow: 0 -1rpx 0 rgba(255, 255, 255, 0.98),
              0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
}

/* ── 语音按钮 ───────────────────────────────────────────── */
.voice-btn {
  width: 76rpx; height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.90);
  border: 0.5rpx solid rgba(0, 0, 0, 0.09);
  border-top-color: rgba(255, 255, 255, 0.98);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  position: relative; overflow: visible;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  transition: background 0.15s, box-shadow 0.15s;
}

.voice-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.voice-stop-icon {
  font-size: 22rpx; color: #FF3B30; line-height: 1;
}

.voice-countdown-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #FF3B30;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.voice-recording {
  background: rgba(255, 59, 48, 0.08);
  border-color: rgba(255, 59, 48, 0.25);
  box-shadow: 0 0 0 6rpx rgba(255, 59, 48, 0.10),
              0 2rpx 8rpx rgba(255, 59, 48, 0.15);
}

.voice-transcribing {
  background: rgba(91, 79, 207, 0.07);
  border-color: rgba(91, 79, 207, 0.20);
}

.voice-pulse-ring {
  width: 32rpx; height: 32rpx;
  border-radius: 50%;
  background: #FF3B30;
  animation: voicePulse 1s ease-out infinite;
}
@keyframes voicePulse {
  0%   { transform: scale(0.8); opacity: 1; }
  60%  { transform: scale(1.3); opacity: 0.6; }
  100% { transform: scale(0.8); opacity: 1; }
}

.voice-spinner {
  width: 34rpx; height: 34rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(91, 79, 207, 0.15);
  border-top-color: #5B4FCF;
  animation: voiceSpin 0.75s linear infinite;
}
@keyframes voiceSpin {
  to { transform: rotate(360deg); }
}

/* 文字输入框 */
.text-input {
  flex: 1;
  min-height: 76rpx;
  max-height: 220rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 24rpx;
  padding: 20rpx 30rpx;
  font-size: 30rpx;
  line-height: 1.55;
  color: #1A1A2E;
  border: 0.5rpx solid rgba(0, 0, 0, 0.09);
  border-top-color: rgba(255, 255, 255, 0.98);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.05),
              inset 0 1rpx 3rpx rgba(0, 0, 0, 0.02);
  box-sizing: border-box;
  word-break: break-word;
  white-space: pre-wrap;
}

/* 发送按钮 */
.send-btn {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.04);
  border: 0.5rpx solid rgba(0, 0, 0, 0.08);
  border-top-color: rgba(255, 255, 255, 0.90);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  transition: all 0.15s;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.90);
}

.send-active {
  background: linear-gradient(135deg, #5B4FCF, #7B6FE0);
  border-color: transparent;
  box-shadow: 0 4rpx 18rpx rgba(91, 79, 207, 0.36),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.20);
}

.send-icon { font-size: 28rpx; color: #AEAEB2; }
.send-active .send-icon { color: #FFFFFF; }

/* ══════════════════════════════════════════════
   功能推荐卡片 — Liquid Glass
══════════════════════════════════════════════ */
.feature-cards-wrap {
  margin-top: 14rpx;
  width: 100%;
  max-width: 520rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.84);
  backdrop-filter: blur(30px);
  -webkit-backdrop-filter: blur(30px);
  border: 0.5rpx solid rgba(255, 255, 255, 0.94);
  border-top-color: rgba(255, 255, 255, 0.98);
  border-radius: 18rpx;
  padding: 22rpx;
  margin-top: 12rpx;
  box-shadow: 0 2rpx 16rpx rgba(91, 79, 207, 0.08),
              0 0.5rpx 2rpx rgba(0, 0, 0, 0.04),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
}

.feature-card:active {
  opacity: 0.75;
  background: rgba(255, 255, 255, 0.95);
}

.fc-icon { font-size: 36rpx; flex-shrink: 0; }
.fc-body { flex: 1; }

.fc-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 4rpx;
}

.fc-desc {
  font-size: 24rpx;
  color: #8E8EA0;
  line-height: 1.4;
}

.fc-arrow {
  font-size: 36rpx;
  color: #5B4FCF;
  font-weight: 400;
  flex-shrink: 0;
}
