.school-view-all-text  { font-size: 26rpx; color: #C4A35A; font-weight: 500; }
.school-view-all-arrow { font-size: 28rpx; color: #C4A35A; }

.school-rec-badge { background: rgba(196, 163, 90, 0.09); border-radius: 100rpx; padding: 4rpx 14rpx; margin-left: 10rpx; }
.school-rec-badge text { font-size: 19rpx; color: #C4A35A; font-weight: 600; }

/* ── 出国备战路线：时间线模块 ── */
.prep-timeline-card {
  background: linear-gradient(135deg, rgba(42,122,90,0.05) 0%, rgba(196,163,90,0.05) 100%);
  border: 1rpx solid rgba(42,122,90,0.15);
  border-radius: 20rpx;
  padding: 28rpx 24rpx 20rpx;
  margin-bottom: 24rpx;
}
.prep-timeline-header {
  display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx;
}
