}
.btn-share {
  background: rgba(196, 163, 90, 0.07);
  border-color: rgba(196, 163, 90, 0.18);
  border-top-color: rgba(255, 255, 255, 0.95);
  color: #C4A35A; font-weight: 600;
}

.btn-retake {
  background: transparent; color: #AEAEB2;
  font-size: 22rpx; border-radius: 48rpx; padding: 16rpx 0; border: none;
}
.btn-retake::after { border: none; }

/* ── 问题反馈入口 ── */
.feedback-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border: 0.5rpx solid rgba(0,0,0,0.08);
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  margin-top: 8rpx;
}

.feedback-icon { font-size: 36rpx; }

.feedback-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  margin-left: 14rpx;
}

.feedback-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A2744;
}

.feedback-sub {
  font-size: 22rpx;
  color: #8E8E93;
}

.feedback-arrow {
  font-size: 32rpx;
  color: #C7C7CC;
}

.cta-card  { display: none; }
.cta-inner { display: none; }

/* ══ 分享弹层 ════════════════════════════════════════════════ */
.share-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.30); z-index: 500;
  display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
}
.share-modal {
  width: 680rpx;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(50px) saturate(200%);
  -webkit-backdrop-filter: blur(50px) saturate(200%);
  border: 0.5rpx solid rgba(0, 0, 0, 0.07);
  border-top-color: rgba(255, 255, 255, 0.98);
  border-radius: 28rpx; overflow: hidden;
  box-shadow: 0 20rpx 80rpx rgba(0, 0, 0, 0.16),
              0 4rpx 16rpx rgba(0, 0, 0, 0.08),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
}
.share-modal-title {
  display: block; text-align: center;
  font-size: 28rpx; color: #1D1D1F; font-weight: 700;
  padding: 32rpx 32rpx 6rpx;
}
.share-modal-sub {
  display: block; text-align: center;
  font-size: 22rpx; color: #8E8E93;
  padding: 0 32rpx 18rpx; line-height: 1.5;
}
.share-preview { width: 680rpx; height: 998rpx; display: block; }
.share-modal-btns { display: flex; gap: 16rpx; padding: 24rpx 32rpx 12rpx; }
.share-save-btn {
  flex: 1;
  background: linear-gradient(135deg, #C4A35A 0%, #E2C97E 50%, #C4A35A 100%);
  border: 0.5rpx solid rgba(255, 255, 255, 0.50);
  color: #3D2800; font-size: 28rpx; font-weight: 700;
  border-radius: 48rpx; padding: 24rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(196, 163, 90, 0.22);
}
.share-forward-btn {
  flex: 1;
  background: linear-gradient(135deg, #1A6EE8 0%, #4D8FF0 100%);
  border: 0.5rpx solid rgba(255, 255, 255, 0.30);
  color: #fff; font-size: 28rpx; font-weight: 600;
  border-radius: 48rpx; padding: 24rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(26, 110, 232, 0.20);
}
.share-cancel-btn-full {
  display: block; width: 100%;
  background: transparent; border: none;
  color: #AEAEB2; font-size: 24rpx;
  padding: 16rpx 0 32rpx; text-align: center;
  box-sizing: border-box;
}
.share-save-btn::after, .share-forward-btn::after,
.share-cancel-btn-full::after { border: none; }

/* ══ 院校推荐区 ══════════════════════════════════════════════ */
.reach-group-header { display: flex; align-items: center; gap: 10rpx; margin: 28rpx 0 14rpx; }
