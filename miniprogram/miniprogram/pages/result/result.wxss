}
.score-context-warm {
  background: linear-gradient(135deg, rgba(255,200,80,0.10) 0%, rgba(255,170,50,0.05) 100%);
  border: 1rpx solid rgba(200,150,50,0.25);
}

.score-context-header {
  display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx;
}
.score-context-icon { font-size: 32rpx; flex-shrink: 0; }
.score-context-headline {
  font-size: 26rpx; font-weight: 700; color: #1C1C1E; flex: 1; line-height: 1.4;
}
.score-context-body {
  font-size: 24rpx; color: #3C3C43; line-height: 1.7; display: block;
}
.score-context-note {
  margin-top: 16rpx;
  background: rgba(255,255,255,0.55);
  border-radius: 12rpx; padding: 14rpx 16rpx;
}
.score-context-note-text {
  font-size: 22rpx; color: #6E6E73; line-height: 1.65;
}

/* ══ AI战略规划 Section ════════════════════════════════════════ */
