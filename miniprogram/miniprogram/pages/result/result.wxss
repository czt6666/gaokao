.src-name    { display: block; font-size: 30rpx; font-weight: 700; color: #1D1D1F; }
.src-name-en { display: block; font-size: 22rpx; color: #8E8E93; margin-top: 4rpx; }
.src-score-col   { display: flex; flex-direction: column; align-items: center; margin-left: 20rpx; flex-shrink: 0; }
.src-score       { font-size: 40rpx; font-weight: 700; color: #C4A35A; line-height: 1.1; }
.src-score-label { font-size: 18rpx; color: #AEAEB2; margin-top: 2rpx; }

.src-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 14rpx; }
.src-tier-tag {
  font-size: 20rpx; font-weight: 700; border-radius: 100rpx; padding: 4rpx 16rpx; letter-spacing: 1rpx;
}
.src-tier-tag.reach  { background: rgba(199,91,42,0.10);  color: #C75B2A; }
.src-tier-tag.match  { background: rgba(0,113,227,0.10);  color: #0071E3; }
.src-tier-tag.safety { background: rgba(42,122,90,0.10);  color: #2A7A5A; }
.src-country-tag { font-size: 20rpx; color: #6E6E73; background: rgba(0,0,0,0.05); border-radius: 100rpx; padding: 4rpx 16rpx; }
