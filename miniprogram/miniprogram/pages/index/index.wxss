/* pages/index/index.wxss */
/* 艺圆智探 · 首页 — 玻璃拟态 + 极简风格 */

page {
  background: linear-gradient(170deg, #E8EAF6 0%, #F5F6FF 45%, #EDE7F6 100%);
  min-height: 100vh;
}

.page {
  display: flex;
  flex-direction: column;
  padding: 0 28rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ══════════════════════════════════════════════
   品牌头部
══════════════════════════════════════════════ */
.brand-header {
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 64rpx 0 52rpx;
}

.brand-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #1A2744;
  letter-spacing: -0.5rpx;
}

.brand-dot {
  font-size: 28rpx;
  color: #AEAEB2;
  font-weight: 400;
}

.brand-sub {
  font-size: 26rpx;
  font-weight: 500;
  color: #8E8E93;
  letter-spacing: 0.5rpx;
}

/* ══════════════════════════════════════════════
   卡片公共基础 — 玻璃拟态
══════════════════════════════════════════════ */
.card {
  border-radius: 28rpx;
  padding: 0;
  margin-bottom: 24rpx;
  overflow: hidden;
  background: rgba(255,255,255,0.62);
  backdrop-filter: blur(24rpx) saturate(1.6);
  -webkit-backdrop-filter: blur(24rpx) saturate(1.6);
  border: 0.5rpx solid rgba(255,255,255,0.72);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}

.card:active {
  opacity: 0.90;
  transform: scale(0.992);
}

.card-inner {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 40rpx 32rpx 28rpx;
}

.card-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-icon {
  font-size: 42rpx;
  line-height: 1;
}

.card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1A2744;
  letter-spacing: -0.3rpx;
  line-height: 1.2;
}

.card-engine {
  font-size: 22rpx;
  font-weight: 600;
  color: #8E8E93;
  letter-spacing: 0.3rpx;
}

.card-desc {
  font-size: 26rpx;
  font-weight: 500;
  color: #555;
  line-height: 1.4;
}

.card-arrow {
  font-size: 48rpx;
  font-weight: 300;
  color: #CACAD0;
  flex-shrink: 0;
  margin-right: -4rpx;
}

.card-footer-tag {
  font-size: 20rpx;
  font-weight: 500;
  text-align: center;
  padding: 12rpx 32rpx 16rpx;
  letter-spacing: 0.5rpx;
  background: rgba(0,0,0,0.03);
  color: #AEAEB2;
  border-top: 0.5rpx solid rgba(0,0,0,0.05);
}

/* ══════════════════════════════════════════════
   卡片1：高考志愿 — Navy accent
══════════════════════════════════════════════ */
.card-icon-gaokao {
  background: rgba(26,39,68,0.08);
  border: 1.5rpx solid rgba(26,39,68,0.15);
}

/* ══════════════════════════════════════════════
   卡片2：美国大学 — Purple accent
══════════════════════════════════════════════ */
.card-abroad {
  /* 继承 .card 的玻璃效果，无需覆盖 */
}

.card-icon-abroad {
  background: rgba(91,79,207,0.08);
  border: 1.5rpx solid rgba(91,79,207,0.15);
}

.card-title-abroad { color: #1A2744; }
.card-engine-abroad { color: #8E8E93; }
.card-desc-abroad { color: #555; }
.card-arrow-abroad { color: #CACAD0; }
.card-footer-tag-abroad {
  color: #AEAEB2;
  background: rgba(0,0,0,0.03);
  border-top: 0.5rpx solid rgba(0,0,0,0.05);
}

/* ══════════════════════════════════════════════
   底部标语
══════════════════════════════════════════════ */
.footer-tagline {
  margin-top: auto;
  padding-top: 40rpx;
  text-align: center;
}

.tagline-text {
  font-size: 22rpx;
  color: #AEAEB2;
  font-weight: 400;
  letter-spacing: 1rpx;
}
