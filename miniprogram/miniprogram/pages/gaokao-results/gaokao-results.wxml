<!-- pages/gaokao-results/gaokao-results.wxml -->
<!-- v3：支付倒计时 + 免费次数 + 裂变分享 -->

<view class="page">

  <!-- ── 顶部信息条 ── -->
  <view class="info-bar">
    <view class="info-item">
      <text class="info-label">位次</text>
      <text class="info-val">{{query.rank}}</text>
    </view>
    <view class="info-sep">·</view>
    <view class="info-item">
      <text class="info-label">省份</text>
      <text class="info-val">{{query.province}}</text>
    </view>
    <view class="info-sep">·</view>
    <view class="info-item">
      <text class="info-label">共匹配</text>
      <text class="info-val">{{totalCount}} 所</text>
    </view>
    <view wx:if="{{query.fromMock}}" class="mock-tag">高考估算</view>
  </view>

  <!-- 当前约束条件 -->
  <view wx:if="{{constraintTags.length}}" class="constraint-bar">
    <text class="constraint-bar-label">筛选条件</text>
    <text wx:for="{{constraintTags}}" wx:key="label" class="constraint-bar-tag">{{item.label}}：{{item.value}}</text>
  </view>

  <!-- ── 顶部推广：2026 填报季会员（替代旧的 ¥39 单次解锁横幅） ── -->
  <view wx:if="{{showSeasonPromo}}" class="season-promo-card season-promo-top" bindtap="onSeasonBannerTap">
    <view class="season-promo-left">
      <text class="season-promo-tag">推荐</text>
      <text class="season-promo-title">2026 填报季会员</text>
      <text class="season-promo-desc">期内无限次重新查询 · 位次微调随时重查 · 志愿表收藏 · PDF 随时下载</text>
      <!-- 有免费次数时显示，独立位置避免与季会员按钮挤占 -->
      <view wx:if="{{hasFreeCredit}}" class="free-unlock-btn season-promo-free" catchtap="onFreeUnlock">🎁 用 1 次免费查询</view>
    </view>
    <view class="season-promo-right">
      <text class="season-promo-price">¥99</text>
      <text class="season-promo-btn">开通</text>
    </view>
  </view>

  <!-- ── Tab 栏 ── -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab==='gems'?'active':''}}"   bindtap="setTab" data-tab="gems">冷门好校 <text class="tab-count">{{gemsCount}}</text></view>
    <view class="tab-item {{activeTab==='surge'?'active':''}}"  bindtap="setTab" data-tab="surge">冲 <text class="tab-count">{{surgeCount}}</text></view>
    <view class="tab-item {{activeTab==='stable'?'active':''}}" bindtap="setTab" data-tab="stable">稳 <text class="tab-count">{{stableCount}}</text></view>
    <view class="tab-item {{activeTab==='safe'?'active':''}}"   bindtap="setTab" data-tab="safe">保 <text class="tab-count">{{safeCount}}</text></view>
  </view>

  <!-- 内容声明 -->
  <text class="ai-gen-notice">推荐结果基于算法模型生成，仅供参考</text>

  <!-- ── 学校列表 ── -->
  <view class="school-list">
    <block wx:for="{{currentList}}" wx:key="idx">

      <!-- 锁定卡片（未付费/试看时最多显示3张锁定预览） -->
      <view wx:if="{{item.locked && (isPaid && !isTrial || item._lockedIdx < 3)}}"
            class="school-card locked-card {{item._unlockProductType === 'trial_report' ? 'locked-card-trial' : 'locked-card-full'}}"
            bindtap="onCardUnlock"
            data-product-type="{{item._unlockProductType}}"
            data-item-idx="{{item.idx}}">
        <!-- 顶部：学校名 + tier + 价值预览标签 -->
        <view class="locked-head">
          <view class="locked-head-left">
            <text class="locked-school-name">{{item.school_name || '院校信息已锁定'}}</text>
            <view class="locked-badge-row">
              <text wx:if="{{item.tier === '985' || item.is_985 === '985' || item.is_985 === '是' || item.is_985 === '1'}}" class="badge badge-985">985</text>
              <text wx:if="{{item.tier === '211' || item.is_211 === '211' || item.is_211 === '是' || item.is_211 === '1'}}" class="badge badge-211">211</text>
              <text wx:if="{{item.tier === '双一流'}}" class="badge badge-syl">双一流</text>
              <text wx:if="{{item.city}}" class="badge badge-city">{{item.city}}</text>
              <text wx:if="{{item.is_hidden_gem}}" class="badge badge-gem">◆ 冷门宝藏</text>
            </view>
            <!-- 价值预览标签（与网页 LockedSchoolCard 一致） -->
            <view class="locked-preview-tags">
              <text wx:if="{{item._lockTagEmpRate}}" class="lock-tag lock-tag-green">就业率 {{item._lockTagEmpRate}}</text>
              <text wx:if="{{item._lockTagCity}}" class="lock-tag lock-tag-blue">{{item._lockTagCity}}</text>
              <text wx:if="{{item._lockTagGem}}" class="lock-tag lock-tag-amber">{{item._lockTagGem}}</text>
              <text wx:if="{{item._lockTagFlagship}}" class="lock-tag lock-tag-violet">王牌专业</text>
            </view>
          </view>
          <text class="locked-pill">🔒 已锁定</text>
        </view>
        <!-- 模糊预览区 -->
        <view class="locked-blur-body">
          <text class="locked-blur-line">专业：██████████</text>
          <text class="locked-blur-line">录取概率：██% · 安全线分析：████████</text>
          <text class="locked-blur-line">近3年最低位次：██,███ / ██,███ / ██,███</text>
          <text class="locked-blur-line">大小年预测：████ · 就业薪资：████元</text>
        </view>
        <!-- 解锁按钮（文案直接来自 enrichList 计算结果） -->
        <view class="locked-unlock-btn {{item._unlockProductType === 'trial_report' ? 'locked-unlock-btn-dark' : ''}}">
          {{item._unlockLabel}}
        </view>
        <text class="locked-unlock-sub">含录取概率 · 安全线 · 历年趋势 · 在读生口碑</text>
      </view>

      <!-- 正常卡片 -->
      <view wx:elif="{{!item.locked}}" class="school-card {{item.is_hidden_gem?'gem-card':''}} {{item.swarm_discovery?'swarm-card':''}}">

        <!-- 顶部 badges 行 -->
        <view class="badge-row badge-row-top">
          <text wx:if="{{item.is_top_pick}}" class="badge badge-top-pick">{{item.top_pick_rank === 1 ? '★ 本档首选' : '智能精选'}}</text>
          <text wx:if="{{item.tier === '985' || item.is_985 === '985' || item.is_985 === '是' || item.is_985 === '1'}}" class="badge badge-985">985</text>
          <text wx:if="{{item.tier === '211' || item.is_211 === '211' || item.is_211 === '是' || item.is_211 === '1'}}" class="badge badge-211">211</text>
          <text wx:if="{{item.tier === '双一流'}}" class="badge badge-syl">双一流</text>
          <text wx:if="{{item.rank_2025 && item.rank_2025 > 0}}" class="badge badge-plain">软科 #{{item.rank_2025}}</text>
          <text wx:if="{{item.is_hidden_gem && item.top_gem}}" class="badge badge-gem">◆ {{item.top_gem.gem_type_label || '冷门价值'}}</text>
          <text wx:if="{{item.swarm_discovery && !item.is_hidden_gem}}" class="badge badge-swarm">◈ 群体强推</text>
        </view>

        <!-- 智能精选 headline -->
        <view wx:if="{{item.is_top_pick && item.top_pick_headline}}" class="top-pick-headline">
          {{item.top_pick_headline}}
        </view>

        <!-- 卡片头部 -->
        <view class="card-head">
          <view class="card-head-left">
            <text class="school-name">{{item.school_name}}</text>
            <text class="major-name">{{item.major_name === '[院校最低分]' ? '院校整体录取' : item.major_name}}<text wx:if="{{item.city}}" class="major-city"> · {{item.city}}</text></text>
            <!-- feature_tags：快扫标签 -->
            <view wx:if="{{item.feature_tags && item.feature_tags.length > 0}}" class="feature-tag-row">
              <text wx:for="{{item.feature_tags}}" wx:for-item="ft" wx:key="*this" class="feature-tag">{{ft}}</text>
            </view>
          </view>
          <view class="prob-block">
            <text class="prob-num" style="color:{{item._probColor}}">{{item._probText}}</text>
            <text class="prob-label">{{item._probTierLabel}}</text>
          </view>
        </view>

        <!-- 概率条 -->
        <view class="prob-bar-track">
          <view class="prob-bar-fill" style="width:{{item._probPct}}%;background:{{item._barColor}}"></view>
        </view>

        <!-- 概率条下方信息（趋势 / 置信度） -->
        <view class="prob-meta-row">
          <text class="prob-meta-trend" wx:if="{{item.big_small_year && item.big_small_year.heat_trend}}">{{item.big_small_year.heat_trend}}</text>
          <text class="prob-meta-conf" wx:if="{{item.confidence}}">置信度 {{item.confidence}}</text>
        </view>

        <!-- 波动警告 -->
        <view wx:if="{{item.volatility_warning}}" class="volatility-warn">{{item.volatility_warning}}</view>

        <!-- 大小年提示 -->
        <text wx:if="{{item.big_small_year && item.big_small_year.status}}" class="big-small-year">大小年：{{item.big_small_year.status}}</text>

        <!-- 行动建议 -->
        <text wx:if="{{item.suggested_action}}" class="suggested-action" style="color:{{item._probTierColor}}">{{item.suggested_action}}</text>

        <!-- 数据栏：去年最低分（+分差） / 近年均位次（+位次差） / 加入志愿按钮（与网页布局一致：分数+位次+按钮同行） -->
        <view class="score-row">
          <view wx:if="{{item.last_year_min_score}}" class="score-cell">
            <text class="score-label">去年最低分</text>
            <text class="score-val score-val-accent">{{item.last_year_min_score}}<text class="score-unit">分</text></text>
            <text wx:if="{{item._scoreDiffText}}" class="score-diff" style="color:{{item._scoreDiffColor}}">{{item._scoreDiffText}}</text>
          </view>
          <view wx:if="{{item.last_year_min_score}}" class="score-sep"></view>
          <view wx:if="{{item.avg_min_rank_3yr}}" class="score-cell">
            <text class="score-label">近年均位次</text>
            <text class="score-val">{{item.avg_min_rank_3yr}}</text>
            <text wx:if="{{item._rankDiffText}}" class="score-diff" style="color:{{item._rankDiffColor}}">{{item._rankDiffText}}</text>
          </view>
          <!-- 加入志愿按钮（竖向，与分数/位次同行右侧） -->
          <view class="score-action" catchtap="addToForm" data-idx="{{index}}">
            <text class="score-action-plus">＋</text>
            <text class="score-action-text">加入志愿</text>
          </view>
        </view>

        <!-- 近 3 年位次趋势迷你柱图（独立一行，填补视觉空档） -->
        <view wx:if="{{item._rankTrend.length > 1}}" class="trend-row">
          <text class="trend-row-label">{{item._rankTrendLabel}}</text>
          <view class="trend-bars">
            <view wx:for="{{item._rankTrend}}" wx:for-item="bar" wx:key="year" class="trend-bar-col">
              <text class="trend-bar-rank">{{bar.rank}}</text>
              <view class="trend-bar-fill {{bar.trend === 'up' ? 'trend-up' : bar.trend === 'down' ? 'trend-down' : 'trend-flat'}}"
                    style="height:{{bar.heightPct}}%"></view>
              <text class="trend-bar-year">{{bar.year}}</text>
            </view>
          </view>
        </view>

        <!-- 就业数据三栏（付费墙：未付费打码 + 解锁） -->
        <view wx:if="{{item._hasEmployment}}" class="employment-bar">
          <block wx:if="{{isPaid && !isTrial}}">
            <view class="emp-cell">
              <text class="emp-label">月薪</text>
              <text class="emp-val">¥{{item._salaryK}}k</text>
            </view>
            <view wx:if="{{item._empRatePct}}" class="emp-cell">
              <text class="emp-label">就业率</text>
              <text class="emp-val">{{item._empRatePct}}%</text>
            </view>
            <view wx:if="{{item._postgradPct}}" class="emp-cell">
              <text class="emp-label">深造率</text>
              <text class="emp-val">{{item._postgradPct}}%</text>
            </view>
          </block>
          <view wx:else class="employment-bar-locked" bindtap="onCardUnlock" data-product-type="{{item._unlockProductType}}" data-item-idx="{{item.idx}}">
            <view class="emp-cell emp-blur"><text class="emp-label">月薪</text><text class="emp-val">¥X.Xk</text></view>
            <view class="emp-cell emp-blur"><text class="emp-label">就业率</text><text class="emp-val">XX%</text></view>
            <view class="emp-cell emp-blur"><text class="emp-label">深造率</text><text class="emp-val">XX%</text></view>
            <text class="employment-bar-mask">🔒 解锁查看就业数据</text>
          </view>
        </view>

        <!-- 推荐理由（付费墙：未付费 → 解锁按钮；已付 → 可展开） -->
        <block wx:if="{{item.reason}}">
          <view wx:if="{{isPaid && !isTrial}}" class="reason-toggle" bindtap="toggleReason" data-idx="{{index}}">
            <text class="reason-toggle-text">{{item._reasonExpanded ? '收起分析 ↑' : '查看推荐理由 ↓'}}</text>
          </view>
          <view wx:else class="reason-toggle reason-toggle-locked" bindtap="onCardUnlock" data-product-type="{{item._unlockProductType}}" data-item-idx="{{item.idx}}">
            <text class="reason-toggle-text reason-toggle-text-locked">🔒 解锁查看推荐理由（冷门分析 · 风险 · 填报策略）</text>
          </view>
          <view wx:if="{{item._reasonExpanded && isPaid && !isTrial}}" class="reason-block">
            <text class="reason-text reason-text-expanded">{{item.reason}}</text>
          </view>
        </block>

        <!-- 「+ 加入志愿」按钮已上移到位次/分数同行（与网页一致），此处不再重复 -->

      </view>
    </block>

    <!-- 锁定折叠提示（未完整付费且有3张以上锁定卡时显示） -->
    <view wx:if="{{!(isPaid && !isTrial) && currentLockedCount > 3}}" class="locked-fold-tip" bindtap="onFoldTap">
      <text class="locked-fold-icon">🔒</text>
      <text class="locked-fold-text">还有 {{currentLockedCount - 3}} 所院校未显示</text>
      <text class="locked-fold-cta">{{isTrial ? '¥39 升级完整报告' : '¥39 解锁查看全部'}}</text>
    </view>

    <!-- 全局无结果 -->
    <view wx:if="{{totalCount===0 && noResultText}}" class="empty">
      <text class="empty-icon">🔍</text>
      <text class="empty-text">{{noResultText}}</text>
    </view>

    <!-- 当前 tab 内无结果 -->
    <view wx:if="{{totalCount>0 && currentList.length===0 && noResultText}}" class="empty">
      <text class="empty-icon">📭</text>
      <text class="empty-text">{{noResultText}}</text>
    </view>
  </view>

  <!-- ── 底部推广：与顶部一模一样的 99 填报季会员 ── -->
  <view wx:if="{{showSeasonPromo}}" class="season-promo-card season-promo-top" bindtap="onSeasonBannerTap">
    <view class="season-promo-left">
      <text class="season-promo-tag">推荐</text>
      <text class="season-promo-title">2026 填报季会员</text>
      <text class="season-promo-desc">期内无限次重新查询 · 位次微调随时重查 · 志愿表收藏 · PDF 随时下载</text>
      <view wx:if="{{hasFreeCredit}}" class="free-unlock-btn season-promo-free" catchtap="onFreeUnlock">🎁 用 1 次免费查询</view>
    </view>
    <view class="season-promo-right">
      <text class="season-promo-price">¥99</text>
      <text class="season-promo-btn">开通</text>
    </view>
  </view>

  <!-- 付费用户操作栏 -->
  <view wx:if="{{isPaid}}" class="paid-actions">
    <view class="paid-action-btn paid-pdf {{generatingPDF?'paid-pdf-loading':''}}" bindtap="downloadReport">
      {{generatingPDF ? '生成中…' : '📄 保存完整PDF报告'}}
    </view>
  </view>

  <!-- 裂变分享入口（付费后显示，好友付费后本人获得一次免费查询） -->
  <view wx:if="{{isPaid && showShareAfterPay}}" class="share-unlock-banner" bindtap="onShareUnlock">
    <view class="sub-banner-left">
      <text class="sub-banner-title">🎁 分享给好友</text>
      <text class="sub-banner-desc">好友首次付费后，你下次查询免费</text>
    </view>
    <view class="sub-banner-arrow">›</view>
  </view>

  <!-- 我的报告入口（付费用户可见） -->
  <view wx:if="{{isPaid}}" class="my-reports-entry" bindtap="goMyReports">
    <text class="mre-text">📁 查看所有历史报告</text>
    <text class="mre-arrow">›</text>
  </view>

  <!-- 底部说明 -->
  <view class="footer-note">水卢冷门高报引擎 · 艺圆智探出品</view>
  <view class="footer-note" style="font-size:11px;color:#aaa;margin-top:4rpx;">数据来源：2025年教育部公开录取数据</view>
  <view class="footer-feedback" bindtap="goFeedback">
    <view class="footer-feedback-left">
      <text class="footer-feedback-icon">💬</text>
      <view class="footer-feedback-info">
        <text class="footer-feedback-title">遇到问题？给我们反馈</text>
        <text class="footer-feedback-sub">数据错误、功能异常、使用建议都可以说</text>
      </view>
    </view>
    <text class="footer-feedback-arrow">›</text>
  </view>

</view>

<!-- ── 支付确认弹窗 ── -->
<view wx:if="{{showPayConfirm}}" class="confirm-mask">
  <view class="confirm-modal">
    <text class="confirm-title">{{confirmTitle}}</text>
    <text class="confirm-price">{{confirmPrice}}</text>
    <text class="confirm-desc">{{confirmDesc}}</text>
    <!-- 邀请码输入 -->
    <view class="refcode-wrap">
      <text class="refcode-label">邀请码（选填）</text>
      <input class="refcode-input" value="{{payRefCode}}" bindinput="onRefCodeInput" placeholder="{{boundRefCode ? '已绑定邀请码，可修改或清空' : '如有邀请码请填写'}}" placeholder-class="refcode-input-ph" />
      <text wx:if="{{boundRefCode && payRefCode === boundRefCode}}" class="refcode-hint refcode-hint-bound">✅ 已绑定邀请码 {{boundRefCode}}</text>
      <text wx:elif="{{payRefCode && (!boundRefCode || payRefCode !== boundRefCode)}}" class="refcode-hint">ℹ️ 使用邀请码 {{payRefCode}}</text>
    </view>
    <view class="confirm-btns">
      <view class="confirm-btn confirm-cancel" bindtap="closePayConfirm">取消</view>
      <view class="confirm-btn confirm-ok" bindtap="onConfirmPay">确认支付</view>
    </view>
  </view>
</view>

<!-- ── 支付后等待 Webhook 倒计时蒙层 ── -->
<view wx:if="{{showPayCountdown}}" class="countdown-mask">
  <view class="countdown-box">
    <text class="countdown-emoji">✅</text>
    <text class="countdown-title">支付成功！</text>
    <text class="countdown-desc">正在为您生成专属报告…</text>
    <view class="countdown-circle">
      <text class="countdown-num">{{payCountdown}}</text>
    </view>
    <text class="countdown-hint">每一份报告都经过算法精心分析\n稍等 {{payCountdown}} 秒即可查看全部院校</text>
  </view>
</view>

<!-- ── 支付成功庆祝弹窗 ── -->
<view wx:if="{{showPaySuccess}}" class="success-mask">
  <view class="success-modal">
    <text class="success-emoji">🎊</text>
    <text class="success-title">报告已解锁！</text>
    <text class="success-desc">全部{{totalCount}}所院校的完整分析已生成\n可在「我的报告」随时查看，或下载PDF保存</text>
    <view class="success-stats">
      <view class="success-stat">
        <text class="success-stat-num">{{surgeCount}}</text>
        <text class="success-stat-label">冲刺</text>
      </view>
      <view class="success-stat">
        <text class="success-stat-num">{{stableCount}}</text>
        <text class="success-stat-label">稳妥</text>
      </view>
      <view class="success-stat">
        <text class="success-stat-num">{{safeCount}}</text>
        <text class="success-stat-label">保底</text>
      </view>
      <view class="success-stat">
        <text class="success-stat-num">{{gemsCount}}</text>
        <text class="success-stat-label">冷门好校</text>
      </view>
    </view>
    <text class="success-close" bindtap="closePaySuccess">开始查看报告 →</text>
    <text class="success-pdf-hint">可在下方点击「保存完整PDF报告」下载，或进入「我的报告」随时查看</text>
  </view>
</view>

<!-- ── 手机号收集弹窗 ── -->
<view wx:if="{{showPhoneModal}}" class="phone-mask">
  <view class="phone-modal">
    <text class="pm-emoji">🎉</text>
    <text class="pm-title">志愿已成功保存！</text>
    <text class="pm-sub">留下手机号，高考出分后我们可以为你提供进一步的报考建议</text>
    <button class="pm-phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">一键授权手机号</button>
    <text class="pm-skip" bindtap="skipPhone">暂不，以后再说</text>
  </view>
</view>
