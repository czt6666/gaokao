/* ══════════════════════════════════════════════════════════════════
   职业愿景板块（Career Vision Section）
   ══════════════════════════════════════════════════════════════════ */
/* 职业愿景独立区块（Hero 紧随，非 section-card）*/
.career-vision-section {
  background: rgba(255, 255, 255, 0.84);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  margin: 0 0 2rpx;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 0.5rpx solid rgba(0, 0, 0, 0.06);
}
.cv-top-row {
  display: flex; flex-direction: row; align-items: center;
  gap: 12rpx; margin-bottom: 20rpx; flex-wrap: wrap;
}
.cv-top-icon { font-size: 36rpx; line-height: 1; }
.cv-top-title { font-size: 30rpx; font-weight: 700; color: #1D1D1F; flex: 1; }

.cv-num { font-size: 32rpx; margin-right: 4rpx; }
.cv-badge {
  background: linear-gradient(135deg, #1D1D1F 0%, #3A3A3C 100%);
  border-radius: 20rpx; padding: 4rpx 16rpx; margin-left: 12rpx;
}
.cv-badge text { font-size: 20rpx; color: #C4A35A; font-weight: 600; letter-spacing: 0.02em; }
.cv-loading { display: flex; flex-direction: column; align-items: center; padding: 40rpx 32rpx; gap: 16rpx; }
.cv-loading-ring {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid rgba(0,113,227,0.15); border-top-color: #0071E3;
  border-radius: 50%; animation: spin 0.9s linear infinite;
}
.cv-loading-text { font-size: 26rpx; color: #6E6E73; }
.cv-body { padding: 0; }
.cv-intro { display: block; font-size: 26rpx; color: #6E6E73; line-height: 1.7; margin-bottom: 24rpx; }
.cv-card {
  background: #F9F9FB; border-radius: 20rpx; padding: 28rpx;
  margin-bottom: 24rpx; border: 1rpx solid rgba(0,0,0,0.06);
  position: relative; overflow: hidden;
}
.cv-card::before {
  content: ''; position: absolute; top: 0; left: 0;
  width: 6rpx; height: 100%;
  background: linear-gradient(180deg, #0071E3 0%, #34C759 100%);
  border-radius: 3rpx 0 0 3rpx;
}
.cv-card-head { display: flex; flex-direction: row; align-items: flex-start; gap: 20rpx; margin-bottom: 24rpx; }
.cv-rank-col { display: flex; flex-direction: column; align-items: center; min-width: 80rpx; padding-top: 4rpx; }
.cv-rank-num { font-size: 22rpx; color: #AEAEB2; font-weight: 700; letter-spacing: 0.02em; }
.cv-match-score { font-size: 40rpx; font-weight: 800; color: #0071E3; line-height: 1.1; letter-spacing: -0.02em; margin-top: 4rpx; }
.cv-match-label { font-size: 20rpx; color: #AEAEB2; margin-top: 2rpx; }
.cv-title-col { flex: 1; }
.cv-icon-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 6rpx; }
.cv-icon { font-size: 36rpx; }
.cv-label { font-size: 32rpx; font-weight: 700; color: #1D1D1F; letter-spacing: -0.01em; }
.cv-tagline { display: block; font-size: 26rpx; color: #6E6E73; line-height: 1.5; }
.cv-reasons { margin-bottom: 20rpx; }
.cv-reasons-label { display: block; font-size: 24rpx; font-weight: 600; color: #3A3A3C; margin-bottom: 10rpx; }
.cv-reason-item { display: flex; flex-direction: row; align-items: flex-start; gap: 8rpx; margin-bottom: 8rpx; }
.cv-reason-dot { font-size: 28rpx; color: #0071E3; line-height: 1.4; }
.cv-reason-text { font-size: 26rpx; color: #3A3A3C; line-height: 1.6; flex: 1; }
.cv-tags-row { display: flex; flex-direction: row; gap: 12rpx; margin-bottom: 24rpx; flex-wrap: wrap; }
.cv-tag { border-radius: 12rpx; padding: 5rpx 16rpx; }
.cv-tag text { font-size: 22rpx; font-weight: 600; }
.cv-tag-stem { background: rgba(52,199,89,0.12); border: 1rpx solid rgba(52,199,89,0.3); }
.cv-tag-stem text { color: #1A8038; }
.cv-tag-stay { background: rgba(0,113,227,0.1); border: 1rpx solid rgba(0,113,227,0.25); }
.cv-tag-stay text { color: #0058B0; }
.cv-explore-btn {
  display: flex; flex-direction: row; align-items: center; justify-content: center;
  gap: 10rpx; background: #1D1D1F; border-radius: 16rpx; padding: 22rpx 0;
}
.cv-explore-text { font-size: 28rpx; font-weight: 600; color: #F5F5F7; letter-spacing: 0.01em; }
.cv-explore-arrow { font-size: 28rpx; color: #C4A35A; }
.cv-disclaimer { display: block; font-size: 22rpx; color: #AEAEB2; text-align: center; margin-top: 8rpx; line-height: 1.6; }
