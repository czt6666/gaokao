/* pages/career-vision/career-vision.wxss — P3 职业愿景详情页样式 */

/* ── 页面基础 ─────────────────────────────────────── */
.page-wrap {
  min-height: 100vh;
  background: #F2F2F7;
  padding-bottom: 60rpx;
}

/* ── 导航栏 ─────────────────────────────────────── */
.cv-nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx 16rpx;
  background: #FFFFFF;
  position: sticky; top: 0; z-index: 100;
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
}
.nav-back {
  display: flex; flex-direction: row; align-items: center; gap: 4rpx;
  margin-right: 24rpx;
}
.nav-back-icon { font-size: 40rpx; color: #0071E3; line-height: 1; }
.nav-back-label { font-size: 28rpx; color: #0071E3; }
.nav-title { font-size: 30rpx; font-weight: 700; color: #1D1D1F; flex: 1; }

/* ── 加载 ─────────────────────────────────────────── */
.cv-loading-wrap {
  display: flex; flex-direction: column; align-items: center;
  padding: 120rpx 32rpx; gap: 20rpx;
}
.cv-loading-ring {
  width: 56rpx; height: 56rpx;
  border: 4rpx solid rgba(0,113,227,0.15); border-top-color: #0071E3;
  border-radius: 50%; animation: spin 0.9s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.cv-loading-text { font-size: 28rpx; color: #6E6E73; }

/* ── Hero 头部 ──────────────────────────────────────── */
.cv-hero {
  display: flex; flex-direction: column; align-items: center;
  padding: 60rpx 40rpx 48rpx;
  background: #FFFFFF;
  margin-bottom: 20rpx;
}
.cv-hero-icon {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}
.cv-hero-label {
  font-size: 44rpx;
  font-weight: 800;
  color: #1D1D1F;
  letter-spacing: -0.02em;
  margin-bottom: 10rpx;
}
.cv-hero-tagline {
  font-size: 28rpx;
  color: #6E6E73;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 28rpx;
  padding: 0 20rpx;
}
.cv-hero-score-row {
  display: flex; flex-direction: row; align-items: center;
  flex-wrap: wrap; gap: 12rpx; justify-content: center;
}
.cv-hero-score-pill {
  display: flex; flex-direction: row; align-items: baseline; gap: 6rpx;
  background: rgba(0,113,227,0.1); border-radius: 40rpx;
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(0,113,227,0.25);
}
.cv-hero-score-num {
  font-size: 36rpx; font-weight: 800; color: #0071E3; letter-spacing: -0.02em;
}
.cv-hero-score-label {
  font-size: 22rpx; color: #0058B0;
}
.cv-hero-stem-pill {
  background: rgba(52,199,89,0.12); border-radius: 40rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(52,199,89,0.3);
}
.cv-hero-stem-pill text { font-size: 22rpx; color: #1A8038; font-weight: 600; }
.cv-hero-stay-pill {
  background: rgba(196,163,90,0.12); border-radius: 40rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(196,163,90,0.3);
}
.cv-hero-stay-pill text { font-size: 22rpx; color: #8B6914; font-weight: 600; }

/* ── 通用 Section 卡片 ──────────────────────────────── */
.cv-section-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 0 24rpx 20rpx;
  overflow: hidden;
}
.cv-section-header {
  display: flex; flex-direction: row; align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}
.cv-section-title-row {
  display: flex; flex-direction: row; align-items: center; gap: 12rpx;
}
.cv-section-num {
  font-size: 24rpx; font-weight: 700; color: #AEAEB2;
  letter-spacing: 0.05em;
}
.cv-section-title {
  font-size: 30rpx; font-weight: 700; color: #1D1D1F;
}
.cv-section-arrow { font-size: 24rpx; color: #AEAEB2; }
.cv-section-body { padding: 0 32rpx 32rpx; }

/* ── S1：概览 ────────────────────────────────────────── */
.cv-section-desc {
  display: block;
  font-size: 27rpx; color: #3A3A3C; line-height: 1.75;
  margin-bottom: 28rpx;
}
.cv-sub-label {
  display: block;
  font-size: 24rpx; font-weight: 600; color: #AEAEB2;
  text-transform: uppercase; letter-spacing: 0.08em;
  margin-bottom: 16rpx;
}
.cv-reason-list { margin-bottom: 28rpx; }
.cv-reason-row {
  display: flex; flex-direction: row; align-items: flex-start;
  gap: 10rpx; margin-bottom: 12rpx;
}
.cv-reason-dot { font-size: 30rpx; color: #0071E3; line-height: 1.4; }
.cv-reason-text { font-size: 27rpx; color: #3A3A3C; line-height: 1.65; flex: 1; }

/* 职业时间线 */
.cv-timeline-row {
  display: flex; flex-direction: row; align-items: center;
  gap: 8rpx; background: #F9F9FB; border-radius: 16rpx;
  padding: 24rpx 20rpx;
}
.cv-tl-item { display: flex; flex-direction: column; align-items: center; flex: 1; gap: 6rpx; }
.cv-tl-year { font-size: 22rpx; color: #AEAEB2; }
.cv-tl-role { font-size: 24rpx; font-weight: 600; color: #1D1D1F; text-align: center; line-height: 1.4; }
.cv-tl-arrow { font-size: 28rpx; color: #AEAEB2; }

/* ── S2：专业方向 ────────────────────────────────────── */
.cv-major-intro {
  display: block; font-size: 26rpx; color: #6E6E73;
  line-height: 1.65; margin-bottom: 20rpx;
}
.cv-major-list { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 16rpx; }
.cv-major-item {
  display: flex; flex-direction: row; align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: #F9F9FB; border-radius: 16rpx;
  border: 2rpx solid transparent;
}
.cv-major-active {
  background: rgba(0,113,227,0.07);
  border-color: rgba(0,113,227,0.35);
}
.cv-major-name { font-size: 28rpx; font-weight: 600; color: #1D1D1F; }
.cv-major-check { font-size: 28rpx; color: #0071E3; font-weight: 700; }
.cv-major-note { display: block; font-size: 22rpx; color: #AEAEB2; line-height: 1.5; }

/* ── S3：路径对比 ────────────────────────────────────── */
.cv-path-grid { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 24rpx; }
.cv-path-card {
  border-radius: 16rpx; padding: 28rpx 24rpx;
  display: flex; flex-direction: column; gap: 10rpx;
}
.cv-path-us { background: rgba(0,113,227,0.06); border: 1rpx solid rgba(0,113,227,0.2); }
.cv-path-cn { background: rgba(255,59,48,0.05); border: 1rpx solid rgba(255,59,48,0.15); }
.cv-path-flag { font-size: 36rpx; }
.cv-path-title { font-size: 28rpx; font-weight: 700; color: #1D1D1F; }
.cv-path-desc { font-size: 26rpx; color: #3A3A3C; line-height: 1.65; }
.cv-path-tag { border-radius: 12rpx; padding: 6rpx 18rpx; align-self: flex-start; }
.cv-path-tag text { font-size: 22rpx; font-weight: 600; }
.cv-tag-green { background: rgba(52,199,89,0.12); border: 1rpx solid rgba(52,199,89,0.3); }
.cv-tag-green text { color: #1A8038; }
.cv-tag-gold { background: rgba(196,163,90,0.12); border: 1rpx solid rgba(196,163,90,0.3); }
.cv-tag-gold text { color: #8B6914; }
.cv-employer-row { margin-top: 4rpx; }
.cv-employer-tags { display: flex; flex-direction: row; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.cv-employer-tag {
  background: #F2F2F7; border-radius: 12rpx; padding: 6rpx 18rpx;
  border: 1rpx solid rgba(0,0,0,0.06);
}
.cv-employer-tag text { font-size: 24rpx; color: #3A3A3C; }

/* ── S4：薪资 ──────────────────────────────────────── */
.cv-salary-card {
  background: #F9F9FB; border-radius: 16rpx;
  padding: 28rpx 24rpx;
  display: flex; flex-direction: column; gap: 10rpx;
}
.cv-salary-label { font-size: 26rpx; font-weight: 600; color: #1D1D1F; }
.cv-salary-note { font-size: 24rpx; color: #6E6E73; line-height: 1.6; }
.cv-salary-bls { font-size: 22rpx; color: #AEAEB2; }

/* ── CTA 行动建议 ───────────────────────────────────── */
.cv-cta-section {
  margin: 24rpx 24rpx 0;
  display: flex; flex-direction: column; gap: 16rpx;
  align-items: center;
}
.cv-cta-headline {
  font-size: 32rpx; font-weight: 800; color: #1D1D1F;
  text-align: center; letter-spacing: -0.01em;
}
.cv-cta-sub {
  font-size: 26rpx; color: #6E6E73; text-align: center; line-height: 1.6;
}
.cv-cta-btn {
  width: 100%; display: flex; flex-direction: row;
  align-items: center; justify-content: center;
  border-radius: 20rpx; padding: 30rpx 0; gap: 10rpx;
  box-sizing: border-box;
}
.cv-cta-primary { background: #1D1D1F; }
.cv-cta-btn-text { font-size: 28rpx; font-weight: 700; color: #F5F5F7; letter-spacing: 0.01em; }
.cv-cta-btn-arrow { font-size: 28rpx; color: #C4A35A; }
.cv-cta-secondary {
  background: #F2F2F7;
  border: 1rpx solid rgba(0,0,0,0.08);
}
.cv-cta-btn-text-sec { font-size: 28rpx; font-weight: 600; color: #1D1D1F; }
.cv-cta-disclaimer {
  font-size: 22rpx; color: #AEAEB2; text-align: center; line-height: 1.6;
  padding: 0 20rpx;
}
