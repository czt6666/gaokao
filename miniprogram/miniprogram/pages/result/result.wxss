/* pages/result/result.wxss — Apple Light Mode */
/* 袁希™ 成长战略报告 · Apple Light × 袁希金 */
@import "/styles/liquid-glass.wxss";

/* ══ 页面画布：Apple.com 近白 ══════════════════════════════ */
page {
  background: linear-gradient(180deg, #FAFBFF 0%, #F4F6FB 55%, #EFF2F8 100%);
  min-height: 100vh;
}

.root {
  background: transparent;
  min-height: 100vh;
  padding-bottom: 60rpx;
  font-family: -apple-system, 'SF Pro Text', 'PingFang SC', sans-serif;
}

/* ══ Loading ════════════════════════════════════════════════ */
.loading-page {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; min-height: 80vh; gap: 24rpx;
}
.loading-ring {
  width: 80rpx; height: 80rpx;
  border: 3rpx solid rgba(196, 163, 90, 0.14);
  border-top-color: #C4A35A;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 32rpx; color: #1D1D1F; font-weight: 600; }
.loading-sub  { font-size: 24rpx; color: #AEAEB2; }

/* ══ Error ══════════════════════════════════════════════════ */
.error-page {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; min-height: 80vh; gap: 20rpx;
}
.error-icon  { font-size: 80rpx; }
.error-title { font-size: 36rpx; font-weight: 700; color: #1D1D1F; }
.error-desc  { font-size: 26rpx; color: #6E6E73; }
.btn-retry {
  background: linear-gradient(135deg, #C4A35A 0%, #E2C97E 50%, #C4A35A 100%);
  color: #3D2800;
  border: 0.5rpx solid rgba(255, 255, 255, 0.50);
  border-radius: 48rpx; padding: 22rpx 60rpx; font-size: 28rpx; font-weight: 700;
  box-shadow: 0 6rpx 24rpx rgba(196, 163, 90, 0.22);
}
.btn-retry::after { border: none; }

/* ══ Hero ════════════════════════════════════════════════════ */
.hero {
  background: rgba(255, 255, 255, 0.84);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border-bottom: 0.5rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.98),
              0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  padding: 60rpx 40rpx 52rpx;
}
.hero-content { display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.hero-avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: rgba(196, 163, 90, 0.09);
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  display: flex; align-items: center; justify-content: center;
  border: 0.5rpx solid rgba(196, 163, 90, 0.22);
  border-top-color: rgba(255, 255, 255, 0.98);
  box-shadow: 0 2rpx 16rpx rgba(196, 163, 90, 0.12),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
}
.hero-initial { font-size: 48rpx; color: #C4A35A; font-weight: 700; }
.hero-name    { font-size: 34rpx; font-weight: 700; color: #1D1D1F; text-align: center; }
.hero-meta    { font-size: 22rpx; color: #AEAEB2; }

/* ── 职业原型主视觉（Jobs 原则：人 > 数字）────────────────── */
.hero-archetype-icon {
  font-size: 96rpx; line-height: 1;
  margin-top: 28rpx; margin-bottom: 4rpx;
}
.hero-archetype-label {
  font-size: 52rpx; font-weight: 800;
  color: #1D1D1F; text-align: center;
  letter-spacing: -0.02em; line-height: 1.2;
  margin-bottom: 20rpx;
}

/* ── 分数辅助行 ─────────────────────────────────────────── */
.hero-score-row {
  display: flex; flex-direction: row; align-items: center;
  flex-wrap: wrap; gap: 14rpx; justify-content: center;
}

/* ── 1% 标记 ──────────────────────────────────────────────── */
.one-pct-badge {
  display: inline-flex; align-items: center;
  background: rgba(196, 163, 90, 0.08);
  border: 0.5rpx solid rgba(196, 163, 90, 0.22);
  border-radius: 100rpx; padding: 8rpx 24rpx;
}
.one-pct-badge-text {
  font-size: 20rpx; font-weight: 700;
  color: rgba(180, 140, 55, 0.85); letter-spacing: 2rpx;
}

.overall-badge { display: flex; align-items: baseline; gap: 6rpx; }
.overall-num   { font-size: 32rpx; font-weight: 800; line-height: 1; }
.overall-unit  { font-size: 22rpx; color: #6E6E73; }
.overall-label { font-size: 22rpx; font-weight: 600; }

/* 地理方向确认徽章（Hero 区）*/
.geo-heard-badge {
  display: flex; align-items: center; gap: 8rpx;
  background: rgba(26, 110, 232, 0.07);
  border: 0.5rpx solid rgba(26, 110, 232, 0.18);
  border-radius: 40rpx; padding: 8rpx 22rpx; margin-top: 10rpx;
}
.geo-heard-icon { font-size: 24rpx; flex-shrink: 0; }
.geo-heard-text { font-size: 24rpx; color: #1A6EE8; font-weight: 500; }

/* ══ Section Card ════════════════════════════════════════════ */
.section-card {
  background: rgba(255, 255, 255, 0.84);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  margin: 16rpx 24rpx 0;
  border-radius: 24rpx;
  border: 0.5rpx solid rgba(0, 0, 0, 0.06);
  border-top-color: rgba(255, 255, 255, 0.98);
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.07),
              0 0.5rpx 2rpx rgba(0, 0, 0, 0.04),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  overflow: hidden;
}
.section-featured {
  border-color: rgba(196, 163, 90, 0.14);
  border-top-color: rgba(255, 255, 255, 0.98);
  box-shadow: 0 4rpx 28rpx rgba(0, 0, 0, 0.09),
              0 0 0 0.5rpx rgba(196, 163, 90, 0.08),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
}
.section-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 32rpx;
}
.section-title-row { display: flex; align-items: center; gap: 16rpx; }
.section-num {
  font-size: 20rpx; font-weight: 800; color: #C4A35A;
  background: rgba(196, 163, 90, 0.09);
  border: 0.5rpx solid rgba(196, 163, 90, 0.20);
  border-radius: 8rpx; padding: 4rpx 12rpx;
}
.section-title  { font-size: 30rpx; font-weight: 700; color: #1D1D1F; }
.section-arrow  { font-size: 22rpx; color: #AEAEB2; }

.featured-tag {
  background: rgba(196, 163, 90, 0.09);
  border: 0.5rpx solid rgba(196, 163, 90, 0.20);
  border-radius: 20rpx; padding: 4rpx 16rpx;
}
.featured-tag text { font-size: 20rpx; color: #C4A35A; font-weight: 600; }

.section-body {
  padding: 0 32rpx 32rpx;
  border-top: 0.5rpx solid rgba(0, 0, 0, 0.05);
}

.sub-label {
  display: block; font-size: 24rpx; font-weight: 700;
  color: #AEAEB2; letter-spacing: 1rpx;
  margin: 28rpx 0 16rpx;
}
.risk-label { color: rgba(255, 59, 48, 0.70); }

/* ══ MI List ════════════════════════════════════════════════ */
.mi-list { display: flex; flex-direction: column; gap: 24rpx; }
.mi-row  { display: flex; align-items: center; margin-bottom: 8rpx; }
.mi-rank {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: rgba(196, 163, 90, 0.09);
  border: 0.5rpx solid rgba(196, 163, 90, 0.20);
  color: #C4A35A; font-size: 20rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; margin-right: 12rpx;
}
.mi-name { font-size: 28rpx; font-weight: 600; color: #1D1D1F; flex: 1; }
.mi-pct  { font-size: 26rpx; font-weight: 700; color: #C4A35A; }
.mi-bar-bg {
  height: 5rpx; background: rgba(0, 0, 0, 0.06);
  border-radius: 3rpx; margin-bottom: 10rpx; overflow: hidden;
}
.mi-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #C4A35A, #E2C97E);
  border-radius: 3rpx;
}
.mi-desc { font-size: 24rpx; color: #6E6E73; line-height: 1.6; }

/* ══ Mindset ════════════════════════════════════════════════ */
.mindset-card {
  background: rgba(0, 0, 0, 0.02);
  border: 0.5rpx solid rgba(0, 0, 0, 0.06);
  border-top-color: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}
.mindset-row  { display: flex; align-items: center; gap: 16rpx; margin-bottom: 10rpx; }
.mindset-score { font-size: 40rpx; font-weight: 800; color: #C4A35A; }
.mindset-level { font-size: 26rpx; font-weight: 700; color: #1D1D1F; }
.mindset-desc  { font-size: 24rpx; color: #6E6E73; line-height: 1.7; }

.stage-tip {
  display: flex; align-items: flex-start; gap: 12rpx;
  background: rgba(0, 0, 0, 0.02);
  border: 0.5rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 12rpx; padding: 20rpx; margin-top: 8rpx;
}
.stage-icon { font-size: 28rpx; }
.stage-text  { font-size: 24rpx; color: #6E6E73; line-height: 1.7; flex: 1; }

/* ══ Family ═════════════════════════════════════════════════ */
.family-tag-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.family-tag {
  flex: 1;
  background: rgba(0, 0, 0, 0.02);
  border: 0.5rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 12rpx; padding: 16rpx; text-align: center;
}
.tag-label { display: block; font-size: 20rpx; color: #AEAEB2; margin-bottom: 6rpx; }
.tag-value { display: block; font-size: 24rpx; font-weight: 700; color: #C4A35A; }

.family-note {
  display: block; font-size: 24rpx; color: #6E6E73; line-height: 1.7;
  margin-bottom: 20rpx;
  background: rgba(196, 163, 90, 0.05);
  border: 0.5rpx solid rgba(196, 163, 90, 0.12);
  border-radius: 12rpx; padding: 16rpx;
}
.quote-block {
  border-left: 3rpx solid rgba(196, 163, 90, 0.30);
  padding: 12rpx 16rpx; margin-bottom: 16rpx;
}
.quote-label { display: block; font-size: 20rpx; color: #AEAEB2; margin-bottom: 6rpx; }
.quote-text  { display: block; font-size: 26rpx; color: #1D1D1F; line-height: 1.6; font-style: italic; }
.consensus-row { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 8rpx; }
.consensus-icon { font-size: 28rpx; }
.consensus-text { font-size: 24rpx; color: #6E6E73; line-height: 1.6; flex: 1; }

.incomplete-tip { text-align: center; padding: 40rpx 0; }
.incomplete-text { display: block; font-size: 26rpx; color: #AEAEB2; margin-bottom: 16rpx; }
.fill-link { display: block; font-size: 26rpx; color: #C4A35A; font-weight: 600; }

/* ══ Dimensions ═════════════════════════════════════════════ */
.dim-list   { display: flex; flex-direction: column; gap: 32rpx; }
.dim-header-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; }
.dim-icon   { font-size: 28rpx; }
.dim-name   { font-size: 28rpx; font-weight: 600; color: #1D1D1F; flex: 1; }
.dim-level-tag { border-radius: 20rpx; padding: 4rpx 16rpx; }
.dim-level-tag text { font-size: 20rpx; font-weight: 700; }
.dim-score  { font-size: 28rpx; font-weight: 800; }
.dim-bar-bg {
  height: 5rpx; background: rgba(0, 0, 0, 0.06);
  border-radius: 3rpx; margin-bottom: 12rpx; overflow: hidden;
}
.dim-bar-fill { height: 100%; border-radius: 3rpx; transition: width 0.4s ease; }
.dim-evidence { font-size: 24rpx; color: #6E6E73; line-height: 1.7; }
.overall-row {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 28rpx; padding-top: 20rpx;
  border-top: 0.5rpx solid rgba(0, 0, 0, 0.06);
}
.overall-row-label { font-size: 28rpx; font-weight: 700; color: #6E6E73; }
.overall-row-score { font-size: 40rpx; font-weight: 800; }

/* ══ Path ════════════════════════════════════════════════════ */
.path-main-card {
  display: flex; align-items: center; gap: 20rpx;
  background: rgba(196, 163, 90, 0.06);
  border: 0.5rpx solid rgba(196, 163, 90, 0.18);
  border-top-color: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}
.path-main-icon  { font-size: 52rpx; }
.path-main-right { display: flex; flex-direction: column; gap: 10rpx; }
.path-main-label { font-size: 34rpx; font-weight: 800; color: #C4A35A; }
.confidence-tag  {
  background: rgba(196, 163, 90, 0.09);
  border: 0.5rpx solid rgba(196, 163, 90, 0.20);
  border-radius: 20rpx; padding: 4rpx 16rpx; align-self: flex-start;
}
.confidence-tag text { font-size: 20rpx; color: #C4A35A; }

.rationale-list { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 24rpx; }
.rationale-item { display: flex; align-items: flex-start; gap: 10rpx; }
.rationale-dot  { font-size: 28rpx; color: #C4A35A; line-height: 1.6; }
.rationale-text { font-size: 26rpx; color: #6E6E73; line-height: 1.6; flex: 1; }

.risk-list  { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 20rpx; }
.risk-item  {
  background: rgba(255, 59, 48, 0.05);
  border: 0.5rpx solid rgba(255, 59, 48, 0.14);
  border-radius: 10rpx; padding: 14rpx 16rpx;
}
.risk-text  { font-size: 24rpx; color: rgba(200, 50, 40, 0.90); line-height: 1.6; }
.alt-path   { display: block; font-size: 22rpx; color: #AEAEB2; margin-top: 8rpx; }

/* ══ Actions ════════════════════════════════════════════════ */
.action-item    { display: flex; gap: 20rpx; padding: 0 0 32rpx; }
.action-num-col { display: flex; flex-direction: column; align-items: center; }
.action-circle  {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: rgba(196, 163, 90, 0.09);
  border: 0.5rpx solid rgba(196, 163, 90, 0.22);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.action-num-text  { font-size: 24rpx; color: #C4A35A; font-weight: 700; }
.action-line      { width: 0.5rpx; flex: 1; min-height: 20rpx; background: rgba(0, 0, 0, 0.08); margin: 8rpx 0; }
.action-content   { flex: 1; padding-top: 6rpx; }
.action-title-row { display: flex; align-items: center; gap: 10rpx; margin-bottom: 6rpx; }
.action-icon      { font-size: 28rpx; }
.action-title     { font-size: 28rpx; font-weight: 700; color: #1D1D1F; flex: 1; line-height: 1.5; }
.action-timeframe {
  display: inline-block; font-size: 20rpx; color: #C4A35A; font-weight: 600;
  background: rgba(196, 163, 90, 0.08);
  border: 0.5rpx solid rgba(196, 163, 90, 0.18);
  border-radius: 20rpx; padding: 4rpx 14rpx; margin-bottom: 10rpx;
}
.action-desc { display: block; font-size: 24rpx; color: #6E6E73; line-height: 1.7; }

/* ══ AI 深度洞察 ═════════════════════════════════════════════ */
.section-ai { border-color: rgba(196, 163, 90, 0.10); }
.ai-num {
  background: rgba(196, 163, 90, 0.09); color: #C4A35A;
  border: 0.5rpx solid rgba(196, 163, 90, 0.20);
}
.ai-badge {
  background: rgba(196, 163, 90, 0.08);
  border: 0.5rpx solid rgba(196, 163, 90, 0.18);
  border-radius: 20rpx; padding: 4rpx 16rpx;
}
.ai-badge text { font-size: 20rpx; color: #C4A35A; font-weight: 600; }

.ai-loading {
  display: flex; align-items: center; gap: 16rpx; padding: 28rpx 32rpx;
}
.ai-loading-ring {
  width: 36rpx; height: 36rpx;
  border: 2.5rpx solid rgba(196, 163, 90, 0.14);
  border-top-color: #C4A35A;
  border-radius: 50%; animation: spin 0.9s linear infinite; flex-shrink: 0;
}
.ai-loading-text { font-size: 24rpx; color: #6E6E73; }

.yuanxi-card {
  background: rgba(196, 163, 90, 0.05);
  border: 0.5rpx solid rgba(196, 163, 90, 0.14);
  border-top-color: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx;
  display: flex; gap: 16rpx; align-items: flex-start;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}
.yuanxi-icon { font-size: 32rpx; color: #C4A35A; flex-shrink: 0; margin-top: 2rpx; }
.yuanxi-text { font-size: 27rpx; color: #1D1D1F; line-height: 1.8; flex: 1; }

.ai-tags-row { display: flex; gap: 12rpx; margin-bottom: 20rpx; flex-wrap: wrap; }
.ai-tag {
  background: rgba(0, 0, 0, 0.02);
  border: 0.5rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 12rpx; padding: 12rpx 16rpx; flex: 1; min-width: 140rpx; text-align: center;
}
.ai-tag-label { display: block; font-size: 20rpx; color: #AEAEB2; margin-bottom: 4rpx; }
.ai-tag-val   { display: block; font-size: 24rpx; font-weight: 700; color: #1D1D1F; }

.ai-quote {
  border-left: 3rpx solid rgba(196, 163, 90, 0.30);
  padding: 12rpx 20rpx; margin-bottom: 20rpx;
  background: rgba(196, 163, 90, 0.04);
  border-radius: 0 12rpx 12rpx 0;
  display: flex; align-items: flex-start; gap: 8rpx;
}
.ai-quote-mark { font-size: 40rpx; color: #C4A35A; line-height: 1; margin-top: -6rpx; flex-shrink: 0; }
.ai-quote-text { font-size: 26rpx; color: #6E6E73; line-height: 1.7; font-style: italic; flex: 1; }

.ai-signal-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.ai-signal {
  flex: 1; border-radius: 14rpx; padding: 20rpx;
  display: flex; align-items: flex-start; gap: 12rpx;
  border: 0.5rpx solid transparent;
}
.ai-signal.strength {
  background: rgba(52, 199, 89, 0.06);
  border-color: rgba(52, 199, 89, 0.16);
}
.ai-signal.risk {
  background: rgba(255, 59, 48, 0.05);
  border-color: rgba(255, 59, 48, 0.14);
}
.signal-icon  { font-size: 28rpx; flex-shrink: 0; }
.signal-body  { display: flex; flex-direction: column; gap: 6rpx; }
.signal-title { font-size: 20rpx; font-weight: 700; }
.ai-signal.strength .signal-title { color: rgba(30, 160, 60, 0.90); }
.ai-signal.risk     .signal-title { color: rgba(200, 50, 40, 0.90); }
.signal-desc { font-size: 23rpx; color: #6E6E73; line-height: 1.6; }

.blindspot-card {
  background: rgba(196, 163, 90, 0.05);
  border: 0.5rpx solid rgba(196, 163, 90, 0.14);
  border-radius: 14rpx; padding: 20rpx;
  display: flex; gap: 12rpx; align-items: flex-start;
}
.blindspot-icon  { font-size: 28rpx; flex-shrink: 0; }
.blindspot-body  { display: flex; flex-direction: column; gap: 6rpx; }
.blindspot-title { font-size: 20rpx; font-weight: 700; color: #C4A35A; }
.blindspot-text  { font-size: 24rpx; color: #6E6E73; line-height: 1.7; }

/* ══ 继续深探 — 主行动卡 ════════════════════════════════════ */
.continue-card {
  margin: 24rpx 24rpx 0;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(40px) saturate(200%);
  -webkit-backdrop-filter: blur(40px) saturate(200%);
  border: 0.5rpx solid rgba(0, 0, 0, 0.06);
  border-top-color: rgba(255, 255, 255, 0.98);
  padding: 40rpx 36rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.09),
              0 2rpx 8rpx rgba(0, 0, 0, 0.05),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
}
.continue-header-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 14rpx; }
.continue-icon  { font-size: 24rpx; color: #C4A35A; flex-shrink: 0; }
.continue-label { font-size: 28rpx; font-weight: 700; color: #1D1D1F; letter-spacing: -0.3rpx; }
.continue-hint  { display: block; font-size: 26rpx; color: #6E6E73; line-height: 1.65; margin-bottom: 28rpx; }

.continue-questions { margin-bottom: 36rpx; display: flex; flex-direction: column; gap: 16rpx; }
.cq-item { display: flex; align-items: flex-start; gap: 12rpx; }
.cq-dot  { font-size: 28rpx; color: #C4A35A; font-weight: 700; line-height: 1.5; flex-shrink: 0; }
.cq-text { font-size: 26rpx; color: #3A3A3C; line-height: 1.55; }

.btn-ask-main {
  background: linear-gradient(135deg, #C4A35A 0%, #E2C97E 50%, #C4A35A 100%);
  color: #3D2800;
  border: 0.5rpx solid rgba(255, 255, 255, 0.55);
  font-size: 30rpx; font-weight: 700; border-radius: 200rpx;
  padding: 30rpx 0; letter-spacing: 1rpx; width: 100%;
  box-shadow: 0 8rpx 32rpx rgba(196, 163, 90, 0.22),
              0 2rpx 6rpx rgba(0, 0, 0, 0.10),
