.src-intro { display: block; font-size: 24rpx; color: #6E6E73; line-height: 1.55; margin-bottom: 14rpx; }

.src-reasons { display: flex; flex-direction: column; gap: 6rpx; margin-bottom: 16rpx; }
.src-reason-item { font-size: 22rpx; color: #2A7A5A; font-weight: 500; }

.src-footer { display: flex; align-items: center; justify-content: space-between; border-top: 0.5rpx solid rgba(0,0,0,0.06); padding-top: 16rpx; }
.src-tuition { font-size: 23rpx; color: #8E8E93; }
.src-arrow   { font-size: 26rpx; color: #C4A35A; font-weight: 600; }

.school-view-all {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  margin-top: 28rpx; padding: 24rpx;
  background: rgba(196, 163, 90, 0.05);
  border: 1rpx dashed rgba(196, 163, 90, 0.28);
  border-radius: 16rpx;
}
