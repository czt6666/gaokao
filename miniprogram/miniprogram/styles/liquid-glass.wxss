/* styles/liquid-glass.wxss — 袁希™ Apple Light Mode 共享设计令牌 */
/* ═══════════════════════════════════════════════════════════
   Apple Light Mode Design System
   背景：#FAFBFF → #EFF2F8 极浅蓝白渐变
   玻璃：rgba(255,255,255,0.84) + blur(40px) 白色磨砂卡片
   品牌：#C4A35A 袁希金（深色/浅色背景均适用）
   文字：#1D1D1F / #6E6E73 / #AEAEB2 — Apple 三级层级
   阴影：0 2px 20px rgba(0,0,0,0.06) — 极轻
   高光：inset 0 1px 0 rgba(255,255,255,0.95) — 镜面顶边
   ═══════════════════════════════════════════════════════════ */

/* ── 浅色页面背景 ─────────────────────────────────────────── */
.lg-bg {
  background: linear-gradient(180deg, #FAFBFF 0%, #F4F6FB 55%, #EFF2F8 100%);
}

/* ── 标准玻璃卡片 ─────────────────────────────────────────── */
.lg-card {
  background: rgba(255, 255, 255, 0.84);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border: 0.5rpx solid rgba(0, 0, 0, 0.06);
  border-top-color: rgba(255, 255, 255, 0.98);
  border-radius: 24rpx;
  box-shadow:
    0 2rpx 20rpx rgba(0, 0, 0, 0.06),
    0 0.5rpx 2rpx rgba(0, 0, 0, 0.03),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  overflow: hidden;
  position: relative;
}

/* 略高浮层卡片 */
.lg-card-elevated {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(50px) saturate(200%);
  -webkit-backdrop-filter: blur(50px) saturate(200%);
  border: 0.5rpx solid rgba(0, 0, 0, 0.06);
  border-top-color: rgba(255, 255, 255, 0.98);
  border-radius: 28rpx;
  box-shadow:
    0 8rpx 40rpx rgba(0, 0, 0, 0.09),
    0 2rpx 8rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  overflow: hidden;
  position: relative;
}

/* 极淡内嵌卡片 */
.lg-card-subtle {
  background: rgba(0, 0, 0, 0.02);
  border: 0.5rpx solid rgba(0, 0, 0, 0.06);
  border-top-color: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

/* 金色强调卡片 */
.lg-card-gold {
  background: rgba(196, 163, 90, 0.06);
  border: 0.5rpx solid rgba(196, 163, 90, 0.16);
  border-top-color: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  box-shadow:
    0 2rpx 12rpx rgba(196, 163, 90, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

/* ── 按钮 ─────────────────────────────────────────────────── */
.lg-btn {
  background: rgba(0, 0, 0, 0.04);
  border: 0.5rpx solid rgba(0, 0, 0, 0.08);
  border-top-color: rgba(255, 255, 255, 0.95);
  border-radius: 48rpx;
  padding: 24rpx 56rpx;
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

/* 品牌金按钮 */
.lg-btn-gold {
  background: linear-gradient(135deg, #C4A35A 0%, #E2C97E 50%, #C4A35A 100%);
  border: 0.5rpx solid rgba(255, 255, 255, 0.50);
  border-radius: 48rpx;
  padding: 24rpx 56rpx;
  box-shadow:
    0 6rpx 24rpx rgba(196, 163, 90, 0.22),
    0 2rpx 6rpx rgba(0, 0, 0, 0.10),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.55);
}

/* ── 标签 / 胶囊 ──────────────────────────────────────────── */
.lg-tag {
  background: rgba(0, 0, 0, 0.04);
  border: 0.5rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 100rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  color: #6E6E73;
  font-weight: 600;
}

.lg-tag-gold {
  background: rgba(196, 163, 90, 0.09);
  border: 0.5rpx solid rgba(196, 163, 90, 0.22);
  border-radius: 100rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  color: #C4A35A;
  font-weight: 700;
}
