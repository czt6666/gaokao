}

.prep-gap-list { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 24rpx; }
.prep-gap-item {
  background: rgba(255,255,255,0.7);
  border-radius: 14rpx; padding: 16rpx 18rpx;
  border-left: 4rpx solid rgba(196,163,90,0.5);
}
