/* pages/school-detail/school-detail.wxss (Apple Design) */

/* ── 头部 ── */
.school-header {
  background: #1D1D1F;
  padding: 40rpx 32rpx 48rpx;
}

.header-top {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.rank-block {
  background: rgba(0, 113, 227, 0.15);
  border: 1rpx solid rgba(0, 113, 227, 0.25);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  text-align: center;
  flex-shrink: 0;
  min-width: 70rpx;
}

.rank-label {
  display: block;
  font-size: 18rpx;
  color: #86868B;
}

.rank-num {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #0071E3;
}

.name-block {
  flex: 1;
}

.school-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 6rpx;
}

.school-name-en {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.header-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.location {
  font-size: 24rpx;
  color: #0071E3;
  flex: 1;
}

.type-badge {
  padding: 6rpx 20rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #FFFFFF;
}

.fit-badge-row {
  margin-top: 8rpx;
}

.fit-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

/* ── 官网 ── */
.website-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(0, 113, 227, 0.08);
  border: 1rpx solid rgba(0, 113, 227, 0.15);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin: 0 32rpx 0;
}

.website-icon {
  font-size: 28rpx;
  color: #0071E3;
}

.website-url {
  flex: 1;
  font-size: 22rpx;
  color: #0071E3;
  word-break: break-all;
  line-height: 1.5;
}

.website-copy {
  font-size: 20rpx;
  color: #86868B;
  flex-shrink: 0;
}

/* ── 核心数据 ── */
.stats-row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1D1D1F;
  margin-bottom: 6rpx;
}

.tuition-val {
  font-size: 20rpx;
}

.stat-label {
  display: block;
  font-size: 20rpx;
  color: #86868B;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
}

/* ── 通用区块 ── */
.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1D1D1F;
  margin-bottom: 16rpx;
}

.intro-text {
  font-size: 28rpx;
  color: #6E6E73;
  line-height: 1.8;
}

/* ── 标签 ── */
.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* ── 专业 ── */
.majors-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.major-chip {
  padding: 10rpx 20rpx;
  background: #F5F5F7;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #1D1D1F;
}

/* ── 个性化专业推荐 ── */
.personalized-majors-section {
  background: rgba(0, 113, 227, 0.08);
  border: 1rpx solid rgba(0, 113, 227, 0.15);
  border-radius: 20rpx;
  margin: 0 32rpx;
}

.personalized-sub {
  display: block;
  font-size: 22rpx;
  color: #6E6E73;
  margin-bottom: 4rpx;
  line-height: 1.6;
}

.mi-inline {
  color: #0071E3;
  font-weight: 600;
}

.major-chip-highlight {
  background: linear-gradient(135deg, #0071E3, #0066CC);
  color: #FFFFFF;
  font-weight: 600;
}

/* ── MI ── */
.mi-subtitle {
  display: block;
  font-size: 22rpx;
  color: #6E6E73;
  margin-bottom: 16rpx;
}

.mi-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.mi-chip {
  padding: 10rpx 24rpx;
  background: rgba(0, 113, 227, 0.08);
  color: #0071E3;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

/* ── 名人校友 ── */
.alumni-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.alumni-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #F5F5F7;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.alumni-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0071E3, #0066CC);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.alumni-info {
  flex: 1;
}

.alumni-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1D1D1F;
  margin-bottom: 4rpx;
}

.alumni-title {
  display: block;
  font-size: 22rpx;
  color: #6E6E73;
}

/* ── 校友感言 ── */
.alumni-quote-section {
  background: rgba(0, 113, 227, 0.04);
  border-left: 6rpx solid #0071E3;
  border-radius: 0 16rpx 16rpx 0;
  margin-left: 32rpx;
  padding-left: 28rpx !important;
}

.quote-mark {
  display: block;
  font-size: 72rpx;
  color: #0071E3;
  line-height: 0.6;
  margin-bottom: 8rpx;
  font-family: Georgia, serif;
}

.quote-text {
  display: block;
  font-size: 26rpx;
  color: #6E6E73;
  line-height: 1.8;
  font-style: italic;
}

.quote-mark-end {
  display: block;
  font-size: 72rpx;
  color: #0071E3;
  line-height: 0.4;
  text-align: right;
  margin-top: 8rpx;
  font-family: Georgia, serif;
}

/* ── 申请要求 ── */
.req-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.req-label {
  font-size: 26rpx;
  color: #86868B;
}

.req-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #1D1D1F;
}

/* ── 课程体系 ── */
.curriculum-badge {
  display: inline-block;
  padding: 12rpx 32rpx;
  background: rgba(0, 113, 227, 0.08);
  color: #0071E3;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
}

/* ── 无报告提示 ── */
.no-assessment-tip {
  background: rgba(255, 149, 0, 0.08);
}

.tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 12rpx;
}

.tip-desc {
  display: block;
  font-size: 24rpx;
  color: #6E6E73;
  line-height: 1.6;
}

/* ══ 官方实时数据（College Scorecard）══ */
/* ══ 官方数据整体容器 ══ */
.live-data-section {
  margin: 0 32rpx;
}

/* 标题行 */
.ld-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.ld-header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.live-badge {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  background: rgba(52, 199, 89, 0.08);
  border-radius: 24rpx;
  color: #34C759;
  border: 1rpx solid rgba(52, 199, 89, 0.20);
}

/* 加载骨架 */
.live-skeleton {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 8rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
}

.skeleton-row {
  height: 28rpx;
  background: #F5F5F7;
  border-radius: 8rpx;
  animation: skeletonPulse 1.4s ease-in-out infinite;
}

.skeleton-row.short {
  width: 60%;
}

@keyframes skeletonPulse {
  0%, 100% { opacity: 0.5; }
  50%       { opacity: 1;   }
}

/* ── 分组卡片 ── */
.ld-group {
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.07);
  padding: 24rpx 24rpx 20rpx;
  margin-bottom: 12rpx;
}

.ld-group-title {
  display: block;
  font-size: 18rpx;
  font-weight: 600;
  color: #AEAEB2;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-bottom: 18rpx;
}

/* 每组数据行（三列） */
.ld-row {
  display: flex;
  gap: 0;
}

.ld-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 0;
  border-right: 1rpx solid rgba(0, 0, 0, 0.06);
}

.ld-item:last-child {
  border-right: none;
}

.ld-val {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #1D1D1F;
  margin-bottom: 6rpx;
  text-align: center;
  line-height: 1.3;
}

.ld-label {
  display: block;
  font-size: 18rpx;
  color: #86868B;
  text-align: center;
  line-height: 1.4;
}

/* 各类数值颜色 */
.ld-val-admission { color: #FF3B30; }  /* 录取率 — 红色（竞争激烈感）*/
.ld-val-tuition   { color: #FF9500; font-size: 24rpx; } /* 学费 — 橙色 */
.ld-val-cny       { color: #FF9500; font-size: 24rpx; } /* 人民币 — 橙色 */
.ld-val-earn      { color: #34C759; } /* 收入 — 绿色（正向）*/
.ld-val-gender    { font-size: 22rpx; } /* 男女比例 — 较小字体 */

/* 净费用备注 */
.ld-note {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  background: rgba(0, 113, 227, 0.05);
  border-radius: 10rpx;
  border: 1rpx solid rgba(0, 113, 227, 0.10);
}

.ld-note-icon {
  font-size: 22rpx;
  flex-shrink: 0;
}

.ld-note-text {
  font-size: 22rpx;
  color: #0071E3;
  line-height: 1.6;
}

/* 助学金分组特殊样式 */
.ld-group-aid {
  background: rgba(52, 199, 89, 0.05);
  border-color: rgba(52, 199, 89, 0.18);
}

.ld-aid-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  flex-wrap: wrap;
}

.ld-aid-pct {
  font-size: 40rpx;
  font-weight: 800;
  color: #34C759;
  flex-shrink: 0;
}

.ld-aid-desc {
  font-size: 24rpx;
  color: #6E6E73;
  line-height: 1.6;
  flex: 1;
}

/* 数据来源声明条 */
.ld-source-bar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background: rgba(0, 0, 0, 0.02);
  border-radius: 12rpx;
  margin-top: 4rpx;
}

.ld-source-icon {
  font-size: 20rpx;
  flex-shrink: 0;
}

.ld-source-text {
  font-size: 18rpx;
  color: #AEAEB2;
  line-height: 1.5;
}

/* ══ 费用三列表：学费 + 生活费 = 总计 ══ */
.ld-cost-table {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 20rpx 16rpx;
  background: rgba(255, 149, 0, 0.05);
  border: 0.5rpx solid rgba(255, 149, 0, 0.20);
  border-radius: 14rpx;
  gap: 4rpx;
}

.ld-cost-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.ld-cost-col-total {
  background: rgba(255, 149, 0, 0.08);
  border-radius: 10rpx;
  padding: 8rpx 4rpx;
}

.ld-cost-plus {
  font-size: 28rpx;
  font-weight: 700;
  color: #AEAEB2;
  align-self: center;
  padding: 0 4rpx;
  flex-shrink: 0;
}

.ld-cost-val {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #FF9500;
  text-align: center;
  line-height: 1.3;
}

.ld-cost-total-val {
  color: #FF6B00;
  font-size: 23rpx;
}

.ld-cost-sub {
  display: block;
  font-size: 18rpx;
  color: #86868B;
  text-align: center;
}

.ld-cost-label {
  display: block;
  font-size: 18rpx;
  color: #6E6E73;
  text-align: center;
  letter-spacing: 0.5rpx;
  margin-top: 4rpx;
}

/* 州内学费提示条 */
.ld-instate-tip {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 10rpx 14rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 8rpx;
}

/* 数据来源备注 */
.ld-note-source { margin-top: 6rpx; opacity: 0.70; }

/* ══ 旧版总费用卡（保留为降级样式）══ */
.ld-total-cost { display: none; }
.ld-total-cost-row { display: none; }
.ld-total-cost-label { display: none; }
.ld-total-cost-val { display: none; }
.ld-total-cost-tip { display: none; }

/* ══ SAT/ACT 区间值 ══ */
.ld-val-range {
  font-size: 26rpx;
  color: #0071E3;
  font-weight: 700;
}

/* ══ 专业分布条形图 ══ */
.ld-prog-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.ld-prog-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ld-prog-bar-wrap {
  width: 120rpx;
  height: 8rpx;
  background: #F0F0F2;
  border-radius: 4rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.ld-prog-bar {
  height: 100%;
  background: linear-gradient(90deg, #0071E3, #34C759);
  border-radius: 4rpx;
  min-width: 4rpx;
}

.ld-prog-label {
  flex: 1;
  font-size: 24rpx;
  color: #1D1D1F;
}

.ld-prog-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #0071E3;
  min-width: 50rpx;
  text-align: right;
}

/* ══ 族裔构成条形图 ══ */
.ld-race-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ld-race-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ld-race-label {
  font-size: 24rpx;
  color: #6E6E73;
  width: 80rpx;
  flex-shrink: 0;
}

.ld-race-bar-wrap {
  flex: 1;
  height: 10rpx;
  background: #F0F0F2;
  border-radius: 5rpx;
  overflow: hidden;
}

.ld-race-bar {
  height: 100%;
  border-radius: 5rpx;
  min-width: 4rpx;
}

.ld-race-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #1D1D1F;
  min-width: 50rpx;
  text-align: right;
}

/* ══════════════════════════════════════════════
   第二层：留学生支持与社区资源
══════════════════════════════════════════════ */
.res-section {
  margin: 0 32rpx;
}

.res-header {
  margin-bottom: 16rpx;
}

.res-header-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1D1D1F;
  margin-bottom: 4rpx;
}

.res-header-sub {
  display: block;
  font-size: 20rpx;
  color: #AEAEB2;
}

/* 通用资源卡片 */
.res-card {
  background: #FFFFFF;
  border: 1rpx solid rgba(0, 0, 0, 0.07);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
}

.res-card-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.res-card-icon {
  font-size: 34rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

.res-card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1D1D1F;
  margin-bottom: 2rpx;
}

.res-card-sub {
  display: block;
  font-size: 20rpx;
  color: #86868B;
}

.res-card-body {
  font-size: 26rpx;
  color: #3C3C43;
  line-height: 1.8;
}

/* CSSA 卡片 */
.res-card-cssa {
  background: rgba(0, 113, 227, 0.04);
  border-color: rgba(0, 113, 227, 0.12);
}

.res-cssa-url {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(0, 113, 227, 0.08);
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  margin-top: 8rpx;
}

.res-url-text {
  font-size: 22rpx;
  color: #0071E3;
  flex: 1;
  word-break: break-all;
}

.res-url-copy {
  font-size: 20rpx;
  color: #86868B;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 隐藏机会卡片 */
.res-card-opps {
  background: rgba(52, 199, 89, 0.04);
  border-color: rgba(52, 199, 89, 0.15);
}

.res-opp-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.res-opp-item:last-child {
  margin-bottom: 0;
}

.res-opp-dot {
  font-size: 28rpx;
  color: #34C759;
  font-weight: 700;
  flex-shrink: 0;
  line-height: 1.6;
}

.res-opp-text {
  font-size: 26rpx;
  color: #3C3C43;
  line-height: 1.7;
  flex: 1;
}

/* 过来人建议卡片 */
.res-card-tip {
  background: rgba(175, 82, 222, 0.04);
  border-color: rgba(175, 82, 222, 0.12);
}

.res-card-tip-text {
  color: #1D1D1F;
  font-style: italic;
}

/* 建设中提示 */
.res-building {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
  background: #F5F5F7;
  border-radius: 16rpx;
  text-align: center;
}

.res-building-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.res-building-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 8rpx;
}

.res-building-sub {
  display: block;
  font-size: 24rpx;
  color: #6E6E73;
  line-height: 1.6;
}

/* ── 底部按钮 ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.07);
}

.bottom-bar .btn-outline,
.bottom-bar .btn-primary {
  flex: 1;
}

/* ══════════════════════════════════════════════════════════════
   🎓 寄宿高中详情样式
══════════════════════════════════════════════════════════════ */

.bd-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin: 0 20rpx 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.bd-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1D1D1F;
  display: block;
  margin-bottom: 18rpx;
}

.bd-row {
  display: flex;
  gap: 0;
  background: #F5F5F7;
  border-radius: 14rpx;
  overflow: hidden;
