/* pages/gaokao/gaokao.wxss */
/* 艺圆智探 · 高考志愿查询页 — 深海军蓝主题 */

page {
  background: #1A2744;
  min-height: 100vh;
}

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ══════════════════════════════════════════════
   引擎品牌头部
══════════════════════════════════════════════ */
.engine-header {
  padding: 40rpx 32rpx 36rpx;
  background: linear-gradient(160deg, #1A2744 0%, #243560 100%);
}

.engine-header-inner {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.engine-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: -0.3rpx;
}

.engine-badge {
  font-size: 18rpx;
  font-weight: 700;
  color: #C9922A;
  background: rgba(201,146,42,0.18);
  border: 0.5rpx solid rgba(201,146,42,0.40);
  border-radius: 980rpx;
  padding: 4rpx 14rpx;
  letter-spacing: 0.5rpx;
}

.engine-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.72);
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.engine-data-tip {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.38);
}

/* ══════════════════════════════════════════════
   表单卡片（白色浮层）
══════════════════════════════════════════════ */
.form-card {
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  margin-top: -16rpx;
  padding: 36rpx 28rpx 32rpx;
  flex: 1;
  box-shadow: 0 -8rpx 30rpx rgba(26,39,68,0.15);
  position: relative;
  z-index: 1;
}

/* ── 模式切换 ── */
.mode-toggle {
  display: flex;
  background: #F0F1FA;
  border-radius: 14rpx;
  padding: 4rpx;
  margin-bottom: 32rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  font-weight: 500;
  color: #8E8E93;
  border-radius: 10rpx;
}

.mode-btn-active {
  background: #FFFFFF;
  color: #1A2744;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.10);
}

/* ── 模式说明 ── */
.mode-hint {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #AEAEB2;
  margin-top: -20rpx;
  margin-bottom: 24rpx;
}

/* ── 数字输入 ── */
.input-section {
  margin-bottom: 24rpx;
}

.input-label {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  color: #8E8E93;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.input-wrap {
  background: #F7F8FF;
  border-radius: 16rpx;
  border: 1.5rpx solid rgba(26,39,68,0.12);
  padding: 0 24rpx;
}

.big-input {
  width: 100%;
  height: 110rpx;
  font-size: 56rpx;
  font-weight: 300;
  color: #1A2744;
  letter-spacing: -1rpx;
}

.big-input-ph {
  color: #C7C7CC;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0;
}

/* ── 省份 + 选科 两列 ── */
.picker-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.picker-cell {
  flex: 1;
  background: #F7F8FF;
  border-radius: 14rpx;
  padding: 18rpx 20rpx 16rpx;
  border: 1rpx solid rgba(26,39,68,0.08);
}

.picker-label {
  display: block;
  font-size: 18rpx;
  font-weight: 600;
  color: #AEAEB2;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.picker-val {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 600;
  color: #1A2744;
}

.picker-val-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
}

.picker-chevron {
  font-size: 28rpx;
  color: #AEAEB2;
  margin-left: 4rpx;
  flex-shrink: 0;
}

.province-tip {
  display: block;
  font-size: 17rpx;
  color: #4ade80;
  margin-top: 6rpx;
  line-height: 1.4;
}

/* ── 选科区域 ── */
.subject-section {
  margin-bottom: 24rpx;
  background: #F7F8FF;
  border-radius: 14rpx;
  padding: 18rpx 20rpx 16rpx;
  border: 1rpx solid rgba(26,39,68,0.08);
}

.subject-label {
  display: block;
  font-size: 18rpx;
  font-weight: 600;
  color: #AEAEB2;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.subject-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.subject-tag {
  padding: 12rpx 20rpx;
  border-radius: 10rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(26,39,68,0.10);
  font-size: 26rpx;
  font-weight: 500;
  color: #1A2744;
  text-align: center;
}

.subject-tag-active {
  background: #1A2744;
  color: #FFFFFF;
  border-color: #1A2744;
  font-weight: 700;
}

.subject-hint {
  display: block;
  font-size: 20rpx;
  color: #DC2626;
  margin-top: 10rpx;
}

/* ── 偏好约束 ── */
.constraint-section {
  margin-bottom: 24rpx;
}

.constraint-toggle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #FFFFFF;
  border: 1.5rpx dashed rgba(26,39,68,0.18);
  border-radius: 14rpx;
  padding: 22rpx 0;
}

.constraint-toggle-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A2744;
}

.constraint-active-badge {
  font-size: 20rpx;
  font-weight: 600;
  color: #C9922A;
  background: rgba(201,146,42,0.12);
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
}

.constraint-panel {
  background: #F7F8FF;
  border-radius: 14rpx;
  padding: 20rpx 20rpx 16rpx;
  border: 1rpx solid rgba(26,39,68,0.08);
}

.constraint-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.constraint-panel-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A2744;
}

.constraint-panel-close {
  font-size: 22rpx;
  font-weight: 500;
  color: #5B4FCF;
  padding: 6rpx 12rpx;
}

.constraint-group {
  margin-bottom: 16rpx;
}

.constraint-group:last-child {
  margin-bottom: 0;
}

.constraint-label {
  display: block;
  font-size: 18rpx;
  font-weight: 600;
  color: #AEAEB2;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.constraint-input-wrap {
  background: #FFFFFF;
  border-radius: 10rpx;
  border: 1rpx solid rgba(26,39,68,0.10);
  padding: 0 16rpx;
}

.constraint-input {
  width: 100%;
  height: 76rpx;
  font-size: 26rpx;
  color: #1A2744;
}

.constraint-input-ph {
  color: #C7C7CC;
  font-size: 24rpx;
}

/* ── 专业关键词输入 ── */
.major-input-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.major-input-wrap {
  flex: 1;
  background: #FFFFFF;
  border-radius: 10rpx;
  border: 1rpx solid rgba(26,39,68,0.10);
  padding: 0 16rpx;
}

.major-input {
  width: 100%;
  height: 72rpx;
  font-size: 26rpx;
  color: #1A2744;
}

.major-add-btn {
  padding: 16rpx 28rpx;
  border-radius: 10rpx;
  background: rgba(26,39,68,0.08);
  font-size: 26rpx;
  font-weight: 600;
  color: #8E8E93;
  flex-shrink: 0;
}

.major-add-btn-active {
  background: #1A2744;
  color: #FFFFFF;
}

.major-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.major-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(26,39,68,0.06);
  border-radius: 8rpx;
  padding: 10rpx 14rpx 10rpx 18rpx;
}

.major-tag-text {
  font-size: 24rpx;
  color: #1A2744;
  font-weight: 500;
}

.major-tag-close {
  font-size: 22rpx;
  color: #8E8E93;
  font-weight: 700;
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
}

.major-tag-close:active {
  background: rgba(26,39,68,0.10);
}

/* ── 错误提示 ── */
.error-msg {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: rgba(255,59,48,0.08);
  border: 0.5rpx solid rgba(255,59,48,0.25);
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
}

.error-icon {
  font-size: 22rpx;
  font-weight: 800;
  color: #DC2626;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(220,38,38,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  text-align: center;
  line-height: 36rpx;
}

.error-text {
  font-size: 24rpx;
  color: #DC2626;
  line-height: 1.6;
  flex: 1;
  white-space: pre-wrap;
}

.error-retry {
  font-size: 24rpx;
  font-weight: 600;
  color: #DC2626;
  background: rgba(220,38,38,0.10);
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
  flex-shrink: 0;
  align-self: center;
}

/* ── 查询按钮 ── */
.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #C9922A 0%, #E8A830 100%);
  border-radius: 980rpx;
  padding: 30rpx 0;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 24rpx rgba(201,146,42,0.40);
}

.submit-btn:active { opacity: 0.88; }

.submit-btn-loading {
  opacity: 0.75;
}

.submit-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 0.5rpx;
}

.spinner {
  width: 34rpx;
  height: 34rpx;
  border: 3rpx solid rgba(255,255,255,0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  flex-shrink: 0;
}

@keyframes spin { to { transform: rotate(360deg); } }

.hint-text {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #AEAEB2;
}

/* ══════════════════════════════════════════════
   分隔线
══════════════════════════════════════════════ */
.separator {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 28rpx 8rpx;
  background: #FFFFFF;
}

.sep-line {
  flex: 1;
  height: 0.5rpx;
  background: rgba(0,0,0,0.10);
}

.sep-text {
  font-size: 22rpx;
  color: #AEAEB2;
  white-space: nowrap;
  font-weight: 500;
}

/* ══════════════════════════════════════════════
   志愿表入口卡片
══════════════════════════════════════════════ */
.form-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  padding: 24rpx 28rpx 28rpx;
}

.form-entry:active { background: #F7F8FF; }

.form-entry-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.form-entry-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.form-entry-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.form-entry-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.form-entry-sub {
  font-size: 22rpx;
  color: #8E8E93;
}

.form-entry-arrow {
  font-size: 44rpx;
  font-weight: 300;
  color: #C7C7CC;
  flex-shrink: 0;
}

/* ── 问题反馈入口 ── */
.feedback-entry {
  text-align: center;
  padding: 28rpx 0 12rpx;
}

.feedback-text {
  font-size: 22rpx;
  color: #8E8E93;
  text-decoration: underline;
  text-decoration-color: rgba(142,142,147,0.4);
}
