/* pages/growth/growth.wxss */
/* 收藏 · 已收藏的美国大学 */

page {
  background: #F5F6FF;
  min-height: 100vh;
  font-family: -apple-system, "SF Pro Display", "PingFang SC", sans-serif;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ══ 空状态 ══ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  gap: 16rpx;
}

.empty-icon { font-size: 64rpx; }

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.empty-sub {
  font-size: 24rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 1.6;
}

.go-browse-btn {
  margin-top: 24rpx;
  padding: 24rpx 60rpx;
  background: linear-gradient(135deg, #5B4FCF, #7B6FE0);
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(91,79,207,0.24);
}

.go-browse-btn:active { opacity: 0.88; }

/* ══ 列表头部 ══ */
.fav-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 10rpx;
}

.fav-count {
  font-size: 24rpx;
  color: #3A3A4C;
  font-weight: 600;
}

.fav-clear-btn {
  font-size: 22rpx;
  color: #FF3B30;
  padding: 6rpx 16rpx;
  background: rgba(255,59,48,0.08);
  border-radius: 980rpx;
}

.fav-clear-btn:active { background: rgba(255,59,48,0.15); }

/* ══ 学校卡片 ══ */
.school-card {
  background: #FFFFFF;
  margin: 0 16rpx 10rpx;
  border-radius: 20rpx;
  padding: 22rpx 20rpx;
  border: 0.5rpx solid rgba(0,0,0,0.06);
  box-shadow: 0 1rpx 8rpx rgba(0,0,0,0.04);
}

.school-card:active {
  background: #F5F6FF;
  border-color: rgba(91,79,207,0.15);
}

.sc-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.sc-name-row {
  flex: 1;
  min-width: 0;
}

.sc-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A2E;
  letter-spacing: -0.3rpx;
  line-height: 1.3;
}

.sc-diff-tag {
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 980rpx;
  padding: 5rpx 16rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.fav-remove {
  font-size: 28rpx;
  color: #FF3B30;
  padding: 4rpx 8rpx;
  flex-shrink: 0;
}

.fav-remove:active { opacity: 0.6; }

.sc-meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 14rpx;
}

.sc-loc { font-size: 22rpx; color: #8E8E93; }
.sc-sep { font-size: 18rpx; color: #C7C7CC; }
.sc-type { font-size: 22rpx; color: #8E8E93; }

.sc-stats-row {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.sc-stat { display: flex; flex-direction: column; gap: 2rpx; }
.sc-stat-label { font-size: 19rpx; color: #AEAEB2; }
.sc-stat-value { font-size: 24rpx; font-weight: 600; color: #1A1A2E; }
