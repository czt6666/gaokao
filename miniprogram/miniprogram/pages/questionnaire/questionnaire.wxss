/* pages/questionnaire/questionnaire.wxss */
/* 袁希™ · 评估问卷 — Apple Light Mode × 袁希金设计系统 */
/* ══════════════════════════════════════════════════════════════
   统一设计令牌（与 result/ai-chat/study-abroad-match 完全一致）
   背景：#FAFBFF → #EFF2F8 极浅蓝白渐变
   品牌：#C4A35A 袁希金
   文字：#1D1D1F / #6E6E73 / #AEAEB2
   卡片：rgba(255,255,255,0.84) + blur(40px) 白色磨砂
   边框：0.5rpx solid rgba(0,0,0,0.06)
   ══════════════════════════════════════════════════════════════ */

page {
  background: linear-gradient(180deg, #FAFBFF 0%, #F4F6FB 55%, #EFF2F8 100%);
  min-height: 100vh;
  font-family: -apple-system, 'SF Pro Text', 'PingFang SC', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ── 进度条区域 — 磨砂玻璃导航条 ──────────────────────────── */
.progress-area {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.84);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  padding: 20rpx 32rpx 16rpx;
  border-bottom: 0.5rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.98),
              0 1rpx 8rpx rgba(0, 0, 0, 0.04);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.part-label {
  font-size: 24rpx;
  color: #C4A35A;
  font-weight: 600;
}

.count-label {
  font-size: 22rpx;
  color: #AEAEB2;
}

.progress-bar-bg {
  height: 4rpx;
  background: rgba(196, 163, 90, 0.12);
  border-radius: 2rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #C4A35A, #E2C97E);
  border-radius: 2rpx;
  transition: width 0.3s ease;
}

/* ── 部分切换过渡动画（保持深色氛围，品牌金色主角）──────── */
.part-transition {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(13, 27, 42, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.part-transition.visible {
  opacity: 1;
  pointer-events: all;
}

.transition-content { text-align: center; }

.transition-icon {
  display: block;
  font-size: 48rpx;
  color: #C4A35A;
  margin-bottom: 20rpx;
}

.transition-message {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.6;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
}

.transition-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

/* ── 题目卡片 ─────────────────────────────────────────────── */
.question-card {
  margin: 24rpx;
  min-height: 480rpx;
  animation: slideIn 0.25s ease;
}

@keyframes slideIn {
  from { opacity: 0; transform: translateX(20rpx); }
  to   { opacity: 1; transform: translateX(0); }
}

.q-number-row { margin-bottom: 24rpx; }

.q-text {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1D1D1F;
  line-height: 1.6;
  margin-bottom: 36rpx;
}

/* ── 答案区域 ─────────────────────────────────────────────── */
.answer-area { margin-top: 8rpx; }

/* 文字 / 数字输入框 */
.text-input {
  width: 100%;
  height: 88rpx;
  border: 0.5rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #1D1D1F;
  background: rgba(255, 255, 255, 0.84);
  box-sizing: border-box;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

.text-input:focus {
  border-color: rgba(196, 163, 90, 0.45);
  background: #FFFFFF;
  box-shadow: 0 0 0 3rpx rgba(196, 163, 90, 0.12),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

.text-center { text-align: center; }

/* 单选题 */
.choice-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 0.5rpx solid rgba(0, 0, 0, 0.08);
  border-top-color: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.84);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  transition: all 0.15s ease;
}

.choice-item.selected {
  border-color: rgba(196, 163, 90, 0.35);
  background: rgba(196, 163, 90, 0.07);
  box-shadow: 0 0 0 0.5rpx rgba(196, 163, 90, 0.18),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

.choice-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 0.5rpx solid rgba(0, 0, 0, 0.18);
  margin-right: 20rpx;
  flex-shrink: 0;
  position: relative;
  transition: all 0.15s ease;
  background: rgba(255, 255, 255, 0.7);
}

.choice-radio.checked {
  border-color: #C4A35A;
  background: #C4A35A;
  box-shadow: 0 2rpx 8rpx rgba(196, 163, 90, 0.30);
}

.choice-radio.checked::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

.choice-label {
  font-size: 30rpx;
  color: #1D1D1F;
  line-height: 1.4;
}

.choice-item.selected .choice-label {
  color: #C4A35A;
  font-weight: 600;
}

/* 频率题 */
.freq-tip {
  font-size: 24rpx;
  color: #6E6E73;
  margin-bottom: 24rpx;
}

.freq-options {
  display: flex;
  gap: 12rpx;
}

.freq-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  border: 0.5rpx solid rgba(0, 0, 0, 0.07);
  border-top-color: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.80);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  transition: all 0.15s ease;
}

.freq-item.selected {
  border-color: rgba(196, 163, 90, 0.35);
  background: rgba(196, 163, 90, 0.08);
  box-shadow: 0 0 0 0.5rpx rgba(196, 163, 90, 0.18),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

.freq-value {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  transition: all 0.15s ease;
}

.freq-value.active {
  background: #C4A35A;
  box-shadow: 0 2rpx 8rpx rgba(196, 163, 90, 0.30);
}

.freq-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #6E6E73;
}

.freq-value.active .freq-num {
  color: #FFFFFF;
}

.freq-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #1D1D1F;
  text-align: center;
  margin-bottom: 4rpx;
}

.freq-item.selected .freq-label {
  color: #C4A35A;
}

.freq-desc {
  font-size: 18rpx;
  color: #AEAEB2;
  text-align: center;
  line-height: 1.3;
}

/* ── 底部操作栏 — 磨砂玻璃 ──────────────────────────────── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border-top: 0.5rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 -1rpx 0 rgba(255, 255, 255, 0.98),
              0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.btn-prev {
  height: 88rpx;
  padding: 0 32rpx;
  background: transparent;
  color: #6E6E73;
  font-size: 28rpx;
  border-radius: 44rpx;
  border: 0.5rpx solid rgba(0, 0, 0, 0.12);
  white-space: nowrap;
}
.btn-prev::after { border: none; }

.btn-next { flex: 1; }
.btn-spacer { flex: 0 0 120rpx; }
