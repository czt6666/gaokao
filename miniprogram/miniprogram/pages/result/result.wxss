.cbc-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 4rpx; }
.cbc-price-block { display: flex; align-items: baseline; gap: 8rpx; flex-wrap: wrap; }
.cbc-price-num  { font-size: 48rpx; font-weight: 700; color: #C4A35A; }
.cbc-price-unit { font-size: 24rpx; color: rgba(255,255,255,0.40); }
.cbc-price-note { font-size: 22rpx; color: rgba(255,255,255,0.28); width: 100%; margin-top: -4rpx; }
.cbc-cta-btn {
  background: linear-gradient(135deg, #C4A35A 0%, #E2C97E 50%, #C4A35A 100%);
  border: 0.5rpx solid rgba(255,255,255,0.35);
  border-radius: 100rpx; padding: 22rpx 44rpx; flex-shrink: 0;
