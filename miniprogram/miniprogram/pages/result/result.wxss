.prep-strength-item { display: flex; align-items: flex-start; gap: 10rpx; }
.prep-strength-dot { font-size: 24rpx; color: #2A7A5A; font-weight: 700; flex-shrink: 0; margin-top: 2rpx; }
.prep-strength-text { font-size: 23rpx; color: #3C3C43; line-height: 1.5; flex: 1; }

/* ── 情绪价值：分数背景说明卡片 ── */
.score-context-card {
  border-radius: 18rpx;
  padding: 24rpx 22rpx 20rpx;
  margin-bottom: 28rpx;
}
.score-context-positive {
  background: linear-gradient(135deg, rgba(42,122,90,0.07) 0%, rgba(42,122,90,0.03) 100%);
