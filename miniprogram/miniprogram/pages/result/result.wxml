      </view>
      <view class="btn-row">
        <button class="btn-copy" bindtap="copyReport">复制报告文字</button>
        <button class="btn-share" bindtap="generateShareCard">生成报告海报</button>
      </view>
      <!-- HIDDEN: 重新生成AI报告（测试专用） -->
      <!--
      <button class="btn-regen-ai" bindtap="regenAIReport">
        <text class="btn-regen-icon">↺</text>
        <view class="btn-regen-body">
          <text class="btn-regen-title">重新生成AI报告</text>
          <text class="btn-regen-sub">跳过评测 · 直接重跑AI云函数 · 调试专用</text>
        </view>
      </button>
      -->
      <!-- 调试状态栏：显示最近一次重新生成的结果 -->
      <view class="regen-status-bar" wx:if="{{regenStatus}}">
        <text class="regen-status-ts">{{regenTs}}</text>
        <text class="regen-status-text">{{regenStatus}}</text>
      </view>

      <!-- 查看完整报告文档（Jobs版：原生排版，可分享/保存）-->
      <button class="btn-export-full" bindtap="exportFullReport">
        <text class="btn-export-icon">↗</text>
        <view class="btn-export-body">
          <text class="btn-export-title">查看完整报告</text>
          <text class="btn-export-sub">原生文档视图 · 可分享给好友 · 可保存长图</text>
        </view>
      </button>
      <!-- 微信原生分享（分享完整报告页） -->
      <button class="btn-share-wx" open-type="share">分享完整报告给朋友</button>
      <button class="btn-retake" bindtap="retake">重新评估</button>

      <!-- 问题反馈入口 -->
      <view class="feedback-entry" bindtap="goFeedback">
        <text class="feedback-icon">💬</text>
        <view class="feedback-info">
          <text class="feedback-title">遇到问题？给我们反馈</text>
          <text class="feedback-sub">数据错误、功能异常、使用建议都可以说</text>
        </view>
        <text class="feedback-arrow">›</text>
      </view>
    </view>

    <!-- 隐藏画布（用于生成分享卡片） -->
    <canvas type="2d" id="shareCanvas" style="position:fixed;left:-9999rpx;top:-9999rpx;width:750rpx;height:1100rpx;"></canvas>
    <!-- 隐藏画布（用于导出完整报告长图）-->
    <canvas type="2d" id="exportCanvas" style="position:fixed;left:-9999rpx;top:-9999rpx;width:750rpx;height:8000rpx;"></canvas>

    <!-- 分享海报预览弹层 -->
    <view class="share-mask" wx:if="{{showPosterModal}}" bindtap="closeShareCard">
      <view class="share-modal" catchtap="">
        <text class="share-modal-title">{{report.meta.childName}}的成长战略海报</text>
        <text class="share-modal-sub">长按保存到相册，或点击"发送给朋友"分享完整报告</text>
        <image class="share-preview" src="{{shareCardPath}}" mode="aspectFit" show-menu-by-longpress="true"></image>
        <view class="share-modal-btns">
          <button class="share-save-btn" bindtap="saveShareCard">保存到相册</button>
          <button class="share-forward-btn" open-type="share">发送给朋友</button>
        </view>
        <button class="share-cancel-btn-full" bindtap="closeShareCard">关闭</button>
      </view>
    </view>

  </block>
</view>
