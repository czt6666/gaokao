/* pages/gaokao-results/gaokao-results.wxss */

page { background: linear-gradient(170deg, #EEF0FA 0%, #F5F6FF 50%, #F0EDF6 100%); min-height: 100vh; }

.page {
  display: flex;
  flex-direction: column;
  padding-bottom: 60rpx;
}

/* ── 顶部信息条 ── */
.info-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #1A2744;
  padding: 20rpx 32rpx;
  flex-wrap: wrap;
}

.info-item { display: flex; align-items: baseline; gap: 6rpx; }

.info-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.50);
}

.info-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
  font-variant-numeric: tabular-nums;
}

.info-sep { font-size: 20rpx; color: rgba(255,255,255,0.25); }

.mock-tag {
  font-size: 18rpx;
  color: #C9922A;
  background: rgba(201,146,42,0.18);
  border: 0.5rpx solid rgba(201,146,42,0.35);
  border-radius: 980rpx;
  padding: 3rpx 14rpx;
  margin-left: auto;
}

/* ── 约束条件展示条 ── */
.constraint-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  background: #FFFFFF;
  padding: 16rpx 28rpx 8rpx;
  border-bottom: 0.5rpx solid rgba(0,0,0,0.04);
}
.constraint-bar-label {
  font-size: 20rpx;
  font-weight: 600;
  color: #8E8E93;
  margin-right: 4rpx;
}
.constraint-bar-tag {
  font-size: 20rpx;
  font-weight: 500;
  color: #1A2744;
  background: #F0F1FA;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

/* ── Tab 栏 ── */
.tab-bar {
  display: flex;
  background: #FFFFFF;
  border-bottom: 0.5rpx solid rgba(0,0,0,0.08);
  overflow-x: auto;
  scrollbar-width: none;
}

.tab-bar::-webkit-scrollbar { display: none; }

.tab-item {
  flex-shrink: 0;
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #8E8E93;
  border-bottom: 4rpx solid transparent;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.tab-item.active {
  color: #1A2744;
  border-bottom-color: #C9922A;
  font-weight: 700;
}

.tab-count {
  font-size: 20rpx;
  font-weight: 600;
  color: #5B4FCF;
  background: rgba(91,79,207,0.10);
  border-radius: 980rpx;
  padding: 2rpx 10rpx;
}

/* ── 季会员横幅 ── */
.season-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #1A2744 0%, #243560 100%);
  margin: 16rpx 24rpx 12rpx;
  border-radius: 18rpx;
  padding: 24rpx 24rpx;
  gap: 10rpx;
}
.season-banner-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #FFFFFF;
}
.season-banner-desc {
  font-size: 20rpx;
  color: rgba(255,255,255,0.65);
  line-height: 1.4;
  text-align: center;
}
.season-banner-btn {
  background: linear-gradient(135deg, #C9922A, #E8A830);
  border-radius: 980rpx;
  padding: 14rpx 48rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-top: 4rpx;
}

/* ── 付费 banner ── */
.pay-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #5B4FCF 0%, #7C6FE0 100%);
  margin: 12rpx 24rpx;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  gap: 10rpx;
}

.pay-banner-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.pay-banner-desc {
  font-size: 20rpx;
  color: rgba(255,255,255,0.65);
  line-height: 1.4;
  text-align: center;
}

.pay-banner-btn-wrap {
  display: flex;
  gap: 12rpx;
  margin-top: 4rpx;
}

.pay-btn {
  background: linear-gradient(135deg, #C9922A, #E8A830);
  border-radius: 980rpx;
  padding: 14rpx 48rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* ── 学校列表 ── */
.school-list {
  padding: 16rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.school-card {
  background: rgba(255,255,255,0.72);
  backdrop-filter: blur(20rpx) saturate(1.5);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.5);
  border-radius: 20rpx;
  padding: 24rpx 24rpx 20rpx;
  border: 0.5rpx solid rgba(255,255,255,0.7);
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

.gem-card  { border-left: 4rpx solid #C9922A; }
.swarm-card { border-left: 4rpx solid #0891B2; }

/* 卡片头部 */
.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.card-head-left { flex: 1; min-width: 0; }

.school-name {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #1A2744;
  margin-bottom: 8rpx;
  line-height: 1.3;
}

.badge-row {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 3rpx 12rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
  font-weight: 600;
}

.badge-985   { background: #FEF2F2; color: #991B1B; border: 0.5rpx solid #FCA5A5; }
.badge-211   { background: #FFFBEB; color: #92400E; border: 0.5rpx solid #FCD34D; }
.badge-syl   { background: #F5F3FF; color: #5B21B6; border: 0.5rpx solid #DDD6FE; }
.badge-plain { background: #F5F5F5; color: #6B7280; border: 0.5rpx solid #E5E7EB; }
.badge-city  { background: #EFF6FF; color: #1E40AF; border: 0.5rpx solid #BFDBFE; }
.badge-gem   { background: rgba(201,146,42,0.15); color: #92400E; border: 0.5rpx solid #FDE68A; }
.badge-swarm { background: rgba(8,145,178,0.10); color: #0E7490; border: 0.5rpx solid rgba(8,145,178,0.30); }
.badge-top-pick { background: #1A2744; color: #E8A830; border: none; letter-spacing: 0.05em; }

/* 顶部 badge 行（与网页一致，放在卡片最上方） */
.badge-row-top { margin-bottom: 10rpx; }

/* 概率块 */
.prob-block {
  flex-shrink: 0;
  text-align: right;
  margin-left: 16rpx;
}

.prob-num {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  margin-bottom: 4rpx;
}

.prob-label {
  font-size: 18rpx;
  color: #AEAEB2;
}

/* 专业名 */
.major-name {
  display: block;
  font-size: 24rpx;
  color: #5B4FCF;
  font-weight: 600;
  margin-bottom: 14rpx;
}

/* 概率条 */
.prob-bar-track {
  height: 8rpx;
  background: #F2F2F7;
  border-radius: 980rpx;
  overflow: hidden;
  margin-bottom: 18rpx;
}

.prob-bar-fill {
  height: 100%;
  border-radius: 980rpx;
  transition: width .6s;
}

/* 数据行 */
.data-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.data-cell { display: flex; flex-direction: column; gap: 3rpx; }

.data-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A2744;
  font-variant-numeric: tabular-nums;
}

.data-label {
  font-size: 18rpx;
  color: #AEAEB2;
}

/* 冷门好校块 */
.gem-block {
  background: #FFFBEB;
  border: 0.5rpx solid #FDE68A;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 14rpx;
}

.gem-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #92400E;
  margin-bottom: 5rpx;
}

.gem-desc {
  font-size: 21rpx;
  color: #78350F;
  line-height: 1.5;
}

/* 大年小年标签 */
.year-tag {
  display: inline-block;
  font-size: 21rpx;
  font-weight: 600;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  margin-bottom: 14rpx;
}

/* 操作按钮组 */
.card-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 6rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.action-primary {
  background: #1A2744;
  color: #FFFFFF;
}

.action-primary:active { opacity: 0.85; }

.action-secondary {
  background: #FFFFFF;
  color: #5B4FCF;
  border: 1rpx solid rgba(91,79,207,0.30);
}

.action-secondary:active { background: rgba(91,79,207,0.06); }

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.empty-icon { font-size: 64rpx; }

.empty-text {
  font-size: 26rpx;
  color: #AEAEB2;
}

/* 底部 */
.footer-note {
  text-align: center;
  font-size: 20rpx;
  color: #C7C7CC;
  padding: 24rpx 40rpx 0;
}

/* ── 季会员推广卡片 ── */
.season-promo-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #1A2744 0%, #243560 100%);
  margin: 0 24rpx 24rpx;
  border-radius: 18rpx;
  padding: 24rpx 24rpx;
  gap: 16rpx;
}
/* 顶部位置变体：上下都加点间距，与 tab 栏分开 */
.season-promo-top {
  margin: 16rpx 24rpx 12rpx;
}
/* 顶部横幅里塞的"免费解锁"按钮 */
.season-promo-free {
  margin-top: 10rpx;
  align-self: flex-start;
}
.season-promo-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.season-promo-tag {
  display: inline-block;
  align-self: flex-start;
  font-size: 18rpx;
  font-weight: 700;
  color: #1A2744;
  background: linear-gradient(135deg, #C9922A, #E8A830);
  border-radius: 6rpx;
  padding: 3rpx 10rpx;
}
.season-promo-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #FFFFFF;
}
.season-promo-desc {
  font-size: 20rpx;
  color: rgba(255,255,255,0.65);
  line-height: 1.4;
}
.season-promo-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.season-promo-price {
  font-size: 36rpx;
  font-weight: 800;
  color: #E8A830;
}
.season-promo-btn {
  background: linear-gradient(135deg, #C9922A, #E8A830);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 980rpx;
  padding: 10rpx 28rpx;
}

/* ── 底部反馈入口（显眼卡片）── */
.footer-feedback {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border: 0.5rpx solid rgba(0,0,0,0.08);
  border-radius: 14rpx;
  margin: 16rpx 24rpx 32rpx;
  padding: 22rpx 24rpx;
}

.footer-feedback-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.footer-feedback-icon { font-size: 36rpx; }

.footer-feedback-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.footer-feedback-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A2744;
}

.footer-feedback-sub {
  font-size: 22rpx;
  color: #8E8E93;
}

.footer-feedback-arrow {
  font-size: 32rpx;
  color: #C7C7CC;
}

/* ── 手机号收集弹窗 ── */
.phone-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.phone-modal {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 52rpx 40rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  width: 100%;
}

.pm-emoji {
  font-size: 56rpx;
  line-height: 1;
  margin-bottom: 4rpx;
}

.pm-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1A1A2E;
  text-align: center;
}

.pm-sub {
  font-size: 24rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 1.6;
  padding: 0 8rpx;
}

.pm-phone-btn {
  width: 100%;
  margin-top: 12rpx;
  background: linear-gradient(135deg, #1A2744, #243560);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 980rpx;
  padding: 28rpx 0;
  text-align: center;
  border: none;
}

.pm-phone-btn::after { border: none; }

.pm-skip {
  font-size: 22rpx;
  color: #AEAEB2;
  padding: 8rpx 0;
  margin-top: 4rpx;
}

/* ══════════════════════════════════════════════
   付费用户操作栏
══════════════════════════════════════════════ */
.paid-actions {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 24rpx 8rpx;
}

.paid-action-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  border: none;
  line-height: 1.4;
}

.paid-action-btn::after { border: none; }

.paid-share {
  background: #1A2744;
  color: #FFFFFF;
}

.paid-consult {
  background: linear-gradient(135deg, #C9922A, #E8A830);
  color: #FFFFFF;
}

/* ══════════════════════════════════════════════
   支付成功庆祝弹窗
══════════════════════════════════════════════ */
.success-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.60);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.success-modal {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 36rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.success-emoji {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

.success-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1A2744;
  margin-bottom: 12rpx;
}

.success-desc {
  font-size: 24rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 28rpx;
  white-space: pre-wrap;
}

.success-stats {
  display: flex;
  width: 100%;
  background: #F7F8FF;
  border-radius: 16rpx;
  padding: 20rpx 0;
  margin-bottom: 28rpx;
}

.success-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.success-stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #1A2744;
  font-variant-numeric: tabular-nums;
}

.success-stat-label {
  font-size: 20rpx;
  color: #8E8E93;
}

.success-share-btn {
  width: 100%;
  background: #1A2744;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 980rpx;
  padding: 26rpx 0;
  text-align: center;
  border: none;
  margin-bottom: 16rpx;
}

.success-share-btn::after { border: none; }

.success-close {
  font-size: 26rpx;
  font-weight: 600;
  color: #C9922A;
  padding: 8rpx 0;
}
.success-pdf-hint {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 8rpx;
}

/* ══════════════════════════════════════════════
   v2 新增样式
══════════════════════════════════════════════ */

/* 锁定卡片 */
.locked-card {
  background: #F9FAFB;
  border: 1rpx dashed #D1D5DB;
  opacity: 0.85;
}

.locked-body {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 4rpx 0;
}

.locked-icon { font-size: 36rpx; flex-shrink: 0; }

.locked-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.locked-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #6B7280;
}

.locked-hint {
  font-size: 20rpx;
  color: #9CA3AF;
  line-height: 1.4;
}

.locked-unlock-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #C9922A, #E8A830);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 980rpx;
  padding: 10rpx 20rpx;
}

.locked-unlock-btn-dark {
  background: linear-gradient(135deg, #1A2744, #243560);
}

/* 锁定折叠提示条 */
.locked-fold-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #FFF8EC, #FFF3D6);
  border: 1rpx solid #E8A830;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}

.locked-fold-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.locked-fold-text {
  flex: 1;
  font-size: 24rpx;
  color: #92400E;
  font-weight: 600;
}

.locked-fold-cta {
  flex-shrink: 0;
  background: linear-gradient(135deg, #C9922A, #E8A830);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 980rpx;
  padding: 10rpx 22rpx;
}

/* 智能精选标签 */
.top-pick-badge {
  display: inline-block;
  background: #1A2744;
  color: #E8A830;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 8rpx;
  padding: 5rpx 14rpx;
  margin-bottom: 10rpx;
}

/* 精选理由 */
.top-pick-headline {
  font-size: 22rpx;
  color: #1A2744;
  background: #EEF2FF;
  border-left: 4rpx solid #5B4FCF;
  border-radius: 0 8rpx 8rpx 0;
  padding: 8rpx 16rpx;
  margin-bottom: 14rpx;
  font-weight: 500;
  line-height: 1.5;
}

/* 推荐理由块 */
.reason-block {
  background: #F8F9FF;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 14rpx;
  border-left: 3rpx solid #5B4FCF;
}

.reason-text {
  font-size: 22rpx;
  color: #3730A3;
  line-height: 1.65;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
}

.reason-text-expanded {
  -webkit-line-clamp: unset;
  display: block;
}

.reason-expand-hint {
  margin-top: 10rpx;
  display: flex;
  justify-content: center;
}

.reason-expand-text {
  font-size: 20rpx;
  color: #5B4FCF;
  font-weight: 600;
}

/* 机会信号标签 */
.opp-signals {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.opp-signal-tag {
  font-size: 20rpx;
  font-weight: 600;
  color: #065F46;
  background: #D1FAE5;
  border: 0.5rpx solid #6EE7B7;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}

/* PDF 按钮 */
.paid-pdf {
  background: linear-gradient(135deg, #1A2744, #243560);
  color: #FFFFFF;
}

.paid-pdf-loading {
  opacity: 0.6;
}

/* 我的报告入口 */
.my-reports-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border: 0.5rpx solid rgba(0,0,0,0.08);
  border-radius: 14rpx;
  margin: 0 24rpx 16rpx;
  padding: 22rpx 24rpx;
}

.mre-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A2744;
}

.mre-arrow {
  font-size: 32rpx;
  color: #C7C7CC;
}

/* 支付成功弹窗 PDF 按钮 */
.success-pdf-btn {
  width: 100%;
  background: linear-gradient(135deg, #C9922A, #E8A830);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 980rpx;
  padding: 24rpx 0;
  text-align: center;
  margin-bottom: 14rpx;
  box-sizing: border-box;
}

/* ══════════════════════════════════════════════
   v3 新增：倒计时蒙层、免费次数、裂变分享条
══════════════════════════════════════════════ */

/* ── 支付后倒计时蒙层 ── */
.countdown-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(10, 16, 40, 0.85);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.countdown-box {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 56rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  width: 100%;
}

.countdown-emoji {
  font-size: 72rpx;
  line-height: 1;
}

.countdown-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1A2744;
}

.countdown-desc {
  font-size: 26rpx;
  color: #5B5EA6;
  font-weight: 600;
}

.countdown-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1A2744, #243560);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 8rpx 0;
}

.countdown-num {
  font-size: 56rpx;
  font-weight: 900;
  color: #FFFFFF;
  font-variant-numeric: tabular-nums;
}

.countdown-hint {
  font-size: 22rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 1.7;
  white-space: pre-wrap;
}

/* ── 付费横幅中的按钮容器 ── */
.pay-banner-btn-wrap {
  display: flex;
  gap: 12rpx;
}

/* ── 免费解锁按钮 ── */
.free-unlock-btn {
  background: linear-gradient(135deg, #059669, #10B981);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 980rpx;
  padding: 10rpx 22rpx;
  text-align: center;
  white-space: nowrap;
}

/* ── 裂变分享入口横幅 ── */
.share-unlock-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFF8EC, #FFF3D6);
  border: 1rpx solid #E8A830;
  border-radius: 16rpx;
  margin: 0 24rpx 16rpx;
  padding: 22rpx 24rpx;
}

.sub-banner-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.sub-banner-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #92400E;
}

.sub-banner-desc {
  font-size: 21rpx;
  color: #B45309;
  line-height: 1.4;
}

.sub-banner-arrow {
  font-size: 40rpx;
  color: #C9922A;
  font-weight: 600;
  margin-left: 12rpx;
}

/* ── 支付确认弹窗 ── */
.confirm-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
  z-index: 3000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}
.confirm-modal {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 36rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  gap: 16rpx;
}
.confirm-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1A2744;
}
.confirm-price {
  font-size: 52rpx;
  font-weight: 900;
  color: #C9922A;
}
.confirm-desc {
  font-size: 24rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 12rpx;
}
.refcode-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.refcode-label {
  font-size: 22rpx;
  color: #86868B;
  align-self: flex-start;
}
.refcode-input {
  width: 100%;
  height: 72rpx;
  background: #F5F5F7;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #1D1D1F;
  box-sizing: border-box;
}
.refcode-input-ph {
  color: #C7C7CC;
  font-size: 24rpx;
}
.refcode-hint {
  font-size: 20rpx;
  color: #0071E3;
  align-self: flex-start;
}
.refcode-hint-bound {
  color: #34C759;
}
.confirm-btns {
  display: flex;
  width: 100%;
  gap: 20rpx;
}
.confirm-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.confirm-cancel {
  background: #F2F2F7;
  color: #8E8E93;
}
.confirm-ok {
  background: linear-gradient(135deg, #C9922A, #E8A830);
  color: #FFFFFF;
}

/* ══════════════════════════════════════════════
   v4：与网页 results/page.tsx 对齐
   - feature_tags 快扫标签
   - 概率元信息（趋势 / 置信度）
   - 波动警告 / 大小年提示 / 行动建议
   - 数据三栏（去年最低分 / 近年均位次 / 位次差）
   - 就业数据付费墙
   - 推荐理由付费墙
   - 锁定卡（学校名 + tier + 价值预览标签 + 模糊预览）
══════════════════════════════════════════════ */

/* 专业名 + 城市行 */
.major-city {
  color: #8E8E93;
  font-weight: 400;
}

/* feature_tags 快扫标签 */
.feature-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 8rpx;
}
.feature-tag {
  font-size: 18rpx;
  color: #6B7280;
  background: #F3F4F6;
  border-radius: 4rpx;
  padding: 2rpx 10rpx;
  white-space: nowrap;
}

/* 概率元信息行 */
.prob-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 6rpx;
  margin-bottom: 6rpx;
}
.prob-meta-trend,
.prob-meta-conf {
  font-size: 20rpx;
  color: #AEAEB2;
}

/* 波动警告 */
.volatility-warn {
  font-size: 20rpx;
  color: #92400E;
  background: #FFFBEB;
  border: 0.5rpx solid #FDE68A;
  border-radius: 8rpx;
  padding: 8rpx 14rpx;
  margin-bottom: 10rpx;
}

/* 大小年提示 */
.big-small-year {
  display: block;
  font-size: 20rpx;
  color: #8E8E93;
  margin-top: 4rpx;
  margin-bottom: 8rpx;
}

/* 行动建议 */
.suggested-action {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

/* 数据三栏（去年最低分 / 近年均位次） */
.score-row {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  padding: 14rpx 0;
  border-top: 0.5rpx solid rgba(0,0,0,0.06);
  margin-top: 6rpx;
  margin-bottom: 8rpx;
}
.score-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.score-sep {
  width: 1rpx;
  background: rgba(0,0,0,0.08);
}
.score-label {
  font-size: 20rpx;
  color: #AEAEB2;
}
.score-val {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A2744;
  font-variant-numeric: tabular-nums;
}
.score-val-accent { color: #C9922A; }
.score-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #AEAEB2;
  margin-left: 4rpx;
}
.score-diff {
  font-size: 20rpx;
  font-weight: 600;
  margin-top: 2rpx;
}

/* 数据栏的「加入志愿」按钮（与网页保持一致：分数+位次+按钮同行） */
.score-action {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  min-width: 120rpx;
  padding: 8rpx 12rpx;
  margin-left: 8rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #1A2744, #243560);
  color: #FFFFFF;
  box-shadow: 0 2rpx 10rpx rgba(26,39,68,0.25);
}
.score-action:active { opacity: 0.85; }
.score-action-plus {
  font-size: 30rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
}
.score-action-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.04em;
}

/* 近 3 年位次趋势迷你柱图（独立行，横排：左标签 + 右柱图） */
.trend-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 4rpx;
  margin-bottom: 10rpx;
  padding: 8rpx 12rpx;
  background: rgba(0,0,0,0.02);
  border-radius: 10rpx;
}
.trend-row-label {
  font-size: 20rpx;
  color: #6B7280;
  flex: 1;
  min-width: 0;
}
.trend-bars {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  height: 60rpx;
  flex-shrink: 0;
}
.trend-bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  width: 36rpx;
  height: 100%;
  justify-content: flex-end;
}
.trend-bar-rank {
  font-size: 15rpx;
  color: #8E8E93;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.trend-bar-fill {
  width: 100%;
  border-radius: 4rpx 4rpx 2rpx 2rpx;
  min-height: 6rpx;
  background: #C7CCD9;
  transition: height .3s;
}
/* 趋势着色：上升 = navy 沉稳；下降 = 暖金；持平 = 灰 */
.trend-up   { background: linear-gradient(to top, #1A2744, #3B4F86); }
.trend-down { background: linear-gradient(to top, #C9922A, #E8A830); }
.trend-flat { background: linear-gradient(to top, #9CA3AF, #C7CCD9); }
.trend-bar-year {
  font-size: 15rpx;
  color: #AEAEB2;
  margin-top: 2rpx;
  line-height: 1;
}

/* 就业数据三栏 */
.employment-bar {
  display: flex;
  gap: 16rpx;
  padding: 14rpx 0;
  border-top: 0.5rpx solid rgba(0,0,0,0.06);
  margin-top: 6rpx;
  margin-bottom: 8rpx;
  position: relative;
}
.emp-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.emp-label {
  font-size: 20rpx;
  color: #AEAEB2;
}
.emp-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A2744;
  font-variant-numeric: tabular-nums;
}
.employment-bar-locked {
  display: flex;
  gap: 16rpx;
  flex: 1;
  position: relative;
}
.emp-blur .emp-val {
  filter: blur(4rpx);
  opacity: 0.55;
}
.employment-bar-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #C9922A;
  letter-spacing: 0.02em;
}

/* 推荐理由付费墙 */
.reason-toggle {
  margin-top: 8rpx;
  margin-bottom: 4rpx;
  padding: 2rpx 0;
}
.reason-toggle-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #C9922A;
  letter-spacing: 0.02em;
}
.reason-toggle-locked .reason-toggle-text-locked {
  color: #8E8E93;
}

/* 锁定卡（重写，与网页 LockedSchoolCard 同结构） */
.locked-card {
  position: relative;
  background: #F9FAFB;
  border: 0.5rpx solid #E5E7EB;
  padding: 0;
  overflow: hidden;
}
.locked-head {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 22rpx 24rpx 14rpx;
}
.locked-head-left {
  flex: 1;
  min-width: 0;
}
.locked-school-name {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #1A2744;
  line-height: 1.3;
  margin-bottom: 8rpx;
}
.locked-badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-bottom: 8rpx;
}
.locked-preview-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}
.lock-tag {
  font-size: 18rpx;
  font-weight: 500;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.lock-tag-green  { background: #ECFDF5; color: #065F46; }
.lock-tag-blue   { background: #EFF6FF; color: #1E40AF; }
.lock-tag-amber  { background: #FFFBEB; color: #92400E; }
.lock-tag-violet { background: #F5F3FF; color: #5B21B6; }

.locked-pill {
  font-size: 20rpx;
  color: #8E8E93;
  background: rgba(0,0,0,0.04);
  border: 0.5rpx solid #E5E7EB;
  border-radius: 980rpx;
  padding: 4rpx 14rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 模糊预览区 */
.locked-blur-body {
  padding: 0 24rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  filter: blur(4rpx);
  opacity: 0.55;
}
.locked-blur-line {
  display: block;
  font-size: 22rpx;
  color: #6B7280;
  line-height: 1.6;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 解锁按钮（与网页一致：试看 = navy；完整报告 = accent） */
.locked-unlock-btn {
  display: block;
  margin: 4rpx 24rpx 8rpx;
  padding: 16rpx 0;
  border-radius: 980rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #C9922A;
  box-shadow: 0 2rpx 12rpx rgba(201,146,42,0.25);
}
.locked-unlock-btn-dark {
  background: #1A2744;
  box-shadow: 0 2rpx 12rpx rgba(26,39,68,0.25);
}
.locked-unlock-sub {
  display: block;
  padding: 0 24rpx 18rpx;
  text-align: center;
  font-size: 20rpx;
  color: #8E8E93;
}

/* 试看 / 完整报告颜色微调（已被 .locked-unlock-btn-dark 覆盖，预留扩展） */
.locked-card-trial  { border-left: 4rpx solid #1A2744; }
.locked-card-full   { border-left: 4rpx solid #C9922A; }
