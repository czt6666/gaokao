.reach-dot.reach  { background: #C75B2A; }
.reach-dot.match  { background: #0071E3; }
.reach-dot.safety { background: #2A7A5A; }

.reach-group-label { font-size: 26rpx; font-weight: 700; }
.reach-group-label.reach  { color: #C75B2A; }
.reach-group-label.match  { color: #0071E3; }
.reach-group-label.safety { color: #2A7A5A; }
