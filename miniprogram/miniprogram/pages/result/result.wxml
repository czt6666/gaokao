<!-- pages/result/result.wxml — 袁希™ 成长战略报告 v2 -->
<view class="root">

  <!-- ══ 加载中 ══ -->
  <view class="loading-page" wx:if="{{status === 'loading'}}">
    <view class="loading-ring"></view>
    <text class="loading-text">正在生成报告{{loadingDots}}</text>
    <text class="loading-sub">袁希方法论分析引擎运行中</text>
  </view>

  <!-- ══ 错误 ══ -->
  <view class="error-page" wx:if="{{status === 'error'}}">
    <text class="error-icon">!</text>
    <text class="error-title">未找到评估数据</text>
    <text class="error-desc">请先完成孩子评估问卷</text>
    <button class="btn-retry" bindtap="retake">重新开始</button>
  </view>

  <!-- ══ 报告主体 ══ -->
  <block wx:if="{{status === 'done' && report}}">

    <!-- Hero 头部 -->
    <view class="hero">
      <view class="hero-content">
        <view class="hero-avatar">
          <text class="hero-initial">{{report.meta.childName[0] || '子'}}</text>
        </view>
        <text class="hero-name">{{report.meta.childName}} 的成长路径</text>
        <text class="hero-meta">{{report.meta.schoolStage}} · {{report.meta.childAge}}岁</text>

        <!-- 主视觉：职业原型（大图标 + 大标题） -->
        <text class="hero-archetype-icon">{{report.pathRecommendation.primaryIcon}}</text>
        <text class="hero-archetype-label">{{report.pathRecommendation.primaryLabel}}</text>

        <!-- 分数降级为辅助信息行 -->
        <view class="hero-score-row">
          <view class="one-pct-badge">
            <text class="one-pct-badge-text">1% 成长路径</text>
          </view>
          <view class="overall-badge">
            <text class="overall-num" style="color:{{report.compatibility.overallColor}}">{{report.compatibility.overall}}</text>
            <text class="overall-unit">分</text>
            <text class="overall-label" style="color:{{report.compatibility.overallColor}}">{{report.compatibility.overallLabel}}</text>
          </view>
        </view>

        <!-- 地理偏好确认标签 -->
        <view class="geo-heard-badge" wx:if="{{report.pathRecommendation.geoFlagLabel}}">
          <text class="geo-heard-icon">·</text>
          <text class="geo-heard-text">你选择的方向：{{report.pathRecommendation.geoFlagLabel}}</text>
        </view>
      </view>
    </view>

    <!-- ── 职业愿景（Hero 紧随，常驻显示）── -->
    <view class="career-vision-section"
          wx:if="{{careerVisions || careerVisionsLoading}}">
      <view class="cv-top-row">
        <text class="cv-top-icon">🧭</text>
        <text class="cv-top-title">{{report.meta.childName}} 的职业愿景</text>
        <view class="cv-badge"><text>天赋驱动</text></view>
      </view>

      <!-- 加载中 -->
      <view class="cv-loading" wx:if="{{careerVisionsLoading && !careerVisions}}">
        <view class="cv-loading-ring"></view>
        <text class="cv-loading-text">正在为 {{report.meta.childName}} 匹配职业路径…</text>
      </view>

      <!-- 卡片列表（常驻可见） -->
      <block wx:if="{{careerVisions && careerVisions.length > 0}}">
        <text class="cv-intro">基于{{report.meta.childName}}的多元智能档案与职业匹配模型，以下是最契合的职业愿景方向：</text>

        <!-- 职业愿景卡片 -->
        <view class="cv-card" wx:for="{{careerVisions}}" wx:key="id">
          <!-- 卡片头部 -->
          <view class="cv-card-head">
            <view class="cv-rank-col">
              <text class="cv-rank-num">#{{index + 1}}</text>
              <text class="cv-match-score">{{item.matchScore}}%</text>
              <text class="cv-match-label">匹配度</text>
            </view>
            <view class="cv-title-col">
              <view class="cv-icon-row">
                <text class="cv-icon">{{item.icon}}</text>
                <text class="cv-label">{{item.label}}</text>
              </view>
              <text class="cv-tagline">{{item.tagline}}</text>
            </view>
          </view>

          <!-- 为什么匹配 -->
          <view class="cv-reasons">
            <text class="cv-reasons-label">为什么适合{{report.meta.childName}}：</text>
            <view class="cv-reason-item" wx:for="{{item.reasons}}" wx:for-item="reason" wx:key="*this">
              <text class="cv-reason-dot">·</text>
              <text class="cv-reason-text">{{reason}}</text>
            </view>
          </view>

          <!-- 标签行 -->
          <view class="cv-tags-row">
            <view class="cv-tag cv-tag-stem" wx:if="{{item.stemOpt}}">
              <text>STEM OPT延签</text>
            </view>
            <view class="cv-tag cv-tag-stay" wx:if="{{item.usStayRate}}">
              <text>留美率 {{item.usStayRate}}</text>
            </view>
          </view>

          <!-- 深入了解按钮 -->
          <view class="cv-explore-btn" bindtap="goCareerVision" data-id="{{item.id}}">
            <text class="cv-explore-text">深入了解这条路</text>
            <text class="cv-explore-arrow">→</text>
          </view>
        </view>

        <text class="cv-disclaimer">职业愿景基于多元智能评分与 Holland 兴趣模型综合计算，供参考。</text>
      </block>
    </view>

    <!-- HIDDEN: AI战略规划 -->
    <view class="section-card section-ai-plan" wx:if="{{false}}">
      <view class="section-header ai-plan-header" bindtap="toggleAiPlan">
        <view class="section-title-row">
          <text class="section-num ai-plan-num">✦</text>
          <text class="section-title">AI战略规划</text>
          <text class="ai-gen-tag">AI 生成</text>
          <view class="ai-plan-badge"><text>含3/5/10年路径</text></view>
        </view>
        <text class="section-arrow">{{showFullPlan ? '▲' : '▼'}}</text>
      </view>
      <!-- 折叠预览：前200字 + 展开按钮 -->
      <view class="ai-plan-preview" wx:if="{{!showFullPlan}}">
        <text class="ai-plan-text">{{aiPlanText.slice(0, 220)}}…</text>
        <view class="ai-plan-expand-btn" bindtap="toggleAiPlan">
          <text class="ai-plan-expand-text">展开完整规划 ↓</text>
        </view>
      </view>
      <!-- 展开后：完整内容 + 收起按钮 -->
      <view class="ai-plan-full" wx:if="{{showFullPlan}}">
        <text class="ai-plan-text">{{aiPlanText}}</text>
        <view class="ai-plan-expand-btn ai-plan-collapse-btn" bindtap="toggleAiPlan">
          <text class="ai-plan-expand-text">收起 ↑</text>
        </view>
      </view>
    </view>

    <!-- ── 顶部咨询入口（紧凑版，报告核心结论之后） ── -->
    <view class="consult-mini-card" bindtap="goConsult">
      <text class="consult-mini-icon">✦</text>
      <view class="consult-mini-body">
        <text class="consult-mini-title">让袁希本人解读这份报告</text>
        <text class="consult-mini-sub">1对1深度咨询 · 厘清下一步</text>
      </view>
      <text class="consult-mini-arrow">→</text>
    </view>

    <!-- ── SECTION 1：孩子画像 ── -->
    <view class="section-card" bindtap="toggleSection" data-section="child">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-num">01</text>
          <text class="section-title">孩子真实画像</text>
        </view>
        <text class="section-arrow">{{expandedSection === 'child' ? '▲' : '▼'}}</text>
      </view>
      <view class="section-body" wx:if="{{expandedSection === 'child'}}">
        <text class="sub-label">能力优势（前三维度）</text>
        <view class="mi-list">
          <view class="mi-item" wx:for="{{report.childPortrait.topIntelligences}}" wx:key="key">
            <view class="mi-row">
              <text class="mi-rank">{{index + 1}}</text>
              <text class="mi-name">{{item.label}}</text>
              <text class="mi-pct">{{item.pct}}%</text>
            </view>
            <view class="mi-bar-bg"><view class="mi-bar-fill" style="width:{{item.pct}}%"></view></view>
            <text class="mi-desc">{{item.description}}</text>
          </view>
        </view>
        <text class="sub-label">思维模式</text>
        <view class="mindset-card">
          <view class="mindset-row">
            <text class="mindset-score">{{report.childPortrait.mindsetScore}}/5</text>
            <text class="mindset-level">{{report.childPortrait.mindsetLabel}}</text>
          </view>
          <text class="mindset-desc">{{report.childPortrait.mindsetDesc}}</text>
        </view>
        <view class="stage-tip">
          <text class="stage-icon">→</text>
          <text class="stage-text">{{report.childPortrait.stageWindow}}</text>
        </view>
      </view>
    </view>

    <!-- ── SECTION 2：家庭画像 ── -->
    <view class="section-card" bindtap="toggleSection" data-section="family">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-num">02</text>
          <text class="section-title">家庭系统画像</text>
        </view>
        <text class="section-arrow">{{expandedSection === 'family' ? '▲' : '▼'}}</text>
      </view>
      <view class="section-body" wx:if="{{expandedSection === 'family'}}">
        <view wx:if="{{report.familyPortrait.complete}}">
          <view class="family-tag-row">
            <view class="family-tag">
              <text class="tag-label">教养风格</text>
              <text class="tag-value">{{report.familyPortrait.parentingLabel}}</text>
            </view>
            <view class="family-tag">
              <text class="tag-label">亲子沟通</text>
              <text class="tag-value">{{report.familyPortrait.commLabel}}</text>
            </view>
            <view class="family-tag">
              <text class="tag-label">家长参与</text>
              <text class="tag-value">{{report.familyPortrait.engagementLabel}}</text>
            </view>
          </view>
          <text class="family-note">{{report.familyPortrait.parentingNote}}</text>
          <view class="quote-block" wx:if="{{report.familyPortrait.keyQuotes.idealPerson}}">
            <text class="quote-label">家长眼中的理想未来</text>
            <text class="quote-text">"{{report.familyPortrait.keyQuotes.idealPerson}}…"</text>
          </view>
          <view class="quote-block" wx:if="{{report.familyPortrait.keyQuotes.childPassion}}">
            <text class="quote-label">孩子的热情所在</text>
            <text class="quote-text">"{{report.familyPortrait.keyQuotes.childPassion}}…"</text>
          </view>
          <view class="consensus-row">
            <text class="consensus-icon">{{report.familyPortrait.valueConsensus === 'aligned' ? '✓' : report.familyPortrait.valueConsensus === 'diverged' ? '!' : '–'}}</text>
            <text class="consensus-text">{{report.familyPortrait.valueConsensus === 'aligned' ? '家长与孩子在教育方向上基本一致' : report.familyPortrait.valueConsensus === 'diverged' ? '家长与孩子在未来方向上存在分歧，建议重点对话' : '价值观方向尚未明确对齐'}}</text>
          </view>
        </view>
        <view wx:else class="incomplete-tip">
          <text class="incomplete-text">重新开始评测，回答完孩子问题后会自动进入家庭视角部分</text>
          <view class="fill-link" bindtap="retake">重新评测 →</view>
        </view>
      </view>
    </view>

    <!-- ── SECTION 3：适配性评分 ── -->
    <view class="section-card" bindtap="toggleSection" data-section="compat">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-num">03</text>
          <text class="section-title">四维适配性评分</text>
        </view>
        <text class="section-arrow">{{expandedSection === 'compat' ? '▲' : '▼'}}</text>
      </view>
      <view class="section-body" wx:if="{{expandedSection === 'compat'}}">

        <!-- 情绪价值卡片：解释分数的温暖说明 -->
        <view class="score-context-card score-context-{{report.compatibility.scoreContext.tone}}">
          <view class="score-context-header">
            <text class="score-context-icon">✦</text>
            <text class="score-context-headline">{{report.compatibility.scoreContext.headline}}</text>
          </view>
          <text class="score-context-body">{{report.compatibility.scoreContext.body}}</text>
          <view wx:if="{{report.compatibility.scoreContext.tone === 'warm'}}" class="score-context-note">
            <text class="score-context-note-text">· 评分是基于您的回答计算的起点参考，不是对孩子潜力的判断。许多认真的家长在填写时会低估孩子，这份报告最大的价值在于指引方向，而不是给孩子贴标签。</text>
          </view>
        </view>

        <view class="dim-list">
          <view class="dim-item" wx:for="{{report.compatibility.dimensions}}" wx:key="id">
            <view class="dim-header-row">
              <text class="dim-icon">{{item.icon}}</text>
              <text class="dim-name">{{item.label}}</text>
              <view class="dim-level-tag" style="background:{{item.levelColor}}20;color:{{item.levelColor}}">
                <text>{{item.levelLabel}}</text>
              </view>
              <text class="dim-score" style="color:{{item.levelColor}}">{{item.score}}</text>
            </view>
            <view class="dim-bar-bg">
              <view class="dim-bar-fill" style="width:{{item.score}}%;background:{{item.levelColor}}"></view>
            </view>
            <text class="dim-evidence">{{item.evidence}}</text>
          </view>
        </view>
        <view class="overall-row">
          <text class="overall-row-label">综合适配度</text>
          <text class="overall-row-score" style="color:{{report.compatibility.overallColor}}">{{report.compatibility.overall}}分 · {{report.compatibility.overallLabel}}</text>
        </view>
      </view>
    </view>

    <!-- ── SECTION 4：路径建议（默认展开） ── -->
    <view class="section-card section-featured" bindtap="toggleSection" data-section="path">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-num">04</text>
          <text class="section-title">路径建议</text>
          <view class="featured-tag"><text>核心结论</text></view>
        </view>
        <text class="section-arrow">{{expandedSection === 'path' ? '▲' : '▼'}}</text>
      </view>
      <view class="section-body" wx:if="{{expandedSection === 'path'}}">
        <view class="path-main-card">
          <text class="path-main-icon">{{report.pathRecommendation.primaryIcon}}</text>
          <view class="path-main-right">
            <text class="path-main-label">{{report.pathRecommendation.primaryLabel}}</text>
            <view class="confidence-tag"><text>{{report.pathRecommendation.confidenceLabel}}</text></view>
          </view>
        </view>
        <text class="sub-label">判断依据</text>
        <view class="rationale-list">
          <view class="rationale-item" wx:for="{{report.pathRecommendation.rationale}}" wx:key="index">
            <text class="rationale-dot">·</text>
            <text class="rationale-text">{{item}}</text>
          </view>
        </view>
        <!-- 出国备战路线：专属时间线模块 -->
        <view wx:if="{{report.pathRecommendation.primaryPath === 'abroad_prep'}}" class="prep-timeline-card">
          <view class="prep-timeline-header">
            <text class="prep-timeline-icon">→</text>
            <text class="prep-timeline-title">出国时间线预估</text>
            <text class="prep-timeline-estimate">{{report.pathRecommendation.timeline}}</text>
          </view>
          <view class="prep-gap-list">
            <view class="prep-gap-item" wx:for="{{report.pathRecommendation.gapDetails}}" wx:key="label">
              <view class="prep-gap-row">
                <text class="prep-gap-label">{{item.label}}</text>
                <text class="prep-gap-months">{{item.months}}个月</text>
              </view>
              <text class="prep-gap-detail">{{item.detail}}</text>
            </view>
          </view>
          <view class="prep-strengths-section">
            <text class="prep-strengths-title">孩子适合出国的优势</text>
            <view class="prep-strengths-list">
              <view class="prep-strength-item" wx:for="{{report.pathRecommendation.strengths}}" wx:key="index">
                <text class="prep-strength-dot">✓</text>
                <text class="prep-strength-text">{{item}}</text>
              </view>
            </view>
          </view>
        </view>

        <text class="sub-label risk-label">{{report.pathRecommendation.primaryPath === 'abroad_prep' ? '当前需要突破的关键项' : '需要关注的风险'}}</text>
        <view class="risk-list">
          <view class="risk-item" wx:for="{{report.pathRecommendation.risks}}" wx:key="index">
            <text class="risk-text">{{item}}</text>
          </view>
        </view>
        <text class="alt-path">{{report.pathRecommendation.primaryPath === 'abroad_prep' ? '目标：' : '备选方案：'}}{{report.pathRecommendation.alternativePath}}</text>
      </view>
    </view>

    <!-- ── SECTION 5：三个行动 ── -->
    <view class="section-card" bindtap="toggleSection" data-section="actions">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-num">05</text>
          <text class="section-title">现在最重要的三件事</text>
        </view>
        <text class="section-arrow">{{expandedSection === 'actions' ? '▲' : '▼'}}</text>
      </view>
      <view class="section-body" wx:if="{{expandedSection === 'actions'}}">
        <view class="action-item" wx:for="{{report.actions}}" wx:key="priority">
          <view class="action-num-col">
            <view class="action-circle"><text class="action-num-text">{{item.priority}}</text></view>
            <view class="action-line" wx:if="{{index < report.actions.length - 1}}"></view>
          </view>
          <view class="action-content">
            <view class="action-title-row">
              <text class="action-icon">{{item.icon}}</text>
              <text class="action-title">{{item.title}}</text>
            </view>
            <text class="action-timeframe">{{item.timeframe}}</text>
            <text class="action-desc">{{item.description}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- HIDDEN: AI 专业方向智能推荐 -->
    <view class="section-card ai-career-section" wx:if="{{false}}">
      <view class="section-header" bindtap="toggleSection" data-section="career">
        <view class="section-title-row">
          <text class="section-num ai-plan-num">✦</text>
          <text class="section-title">专业方向智能推荐</text>
          <text class="ai-gen-tag">AI 生成</text>
          <view class="ai-plan-badge"><text>基于天赋 · 有具体理由</text></view>
        </view>
        <text class="section-arrow">{{expandedSection === 'career' ? '▲' : '▼'}}</text>
      </view>

      <!-- 加载中 -->
      <view class="ai-career-loading" wx:if="{{aiFullReportLoading && !aiFullReport}}">
        <view class="ai-career-loading-ring"></view>
        <text class="ai-career-loading-text">正在分析 {{report.meta.childName}} 的天赋档案，生成专业推荐理由…</text>
      </view>

      <!-- 展开内容 -->
      <view class="section-body" wx:if="{{aiFullReport && expandedSection === 'career'}}">

        <!-- 天赋密码叙事 -->
        <view class="ai-gift-card" wx:if="{{aiFullReport.giftNarrative}}">
          <text class="ai-gift-label">✦ 天赋密码解读</text>
          <text class="ai-gift-text">{{aiFullReport.giftNarrative}}</text>
        </view>

        <!-- 专业方向推荐列表 -->
        <view wx:if="{{aiFullReport.careerMajorRecs && aiFullReport.careerMajorRecs.length > 0}}">
          <text class="sub-label">AI 推荐专业方向（针对{{report.meta.childName}}）</text>
          <view class="career-rec-card" wx:for="{{aiFullReport.careerMajorRecs}}" wx:key="majorName">
            <view class="career-rec-header">
              <text class="career-rec-num">{{index + 1}}</text>
              <text class="career-rec-major">{{item.majorName}}</text>
            </view>
            <view class="career-rec-why">
              <text class="career-rec-why-label">为什么适合{{report.meta.childName}}：</text>
              <text class="career-rec-why-text">{{item.whyThisChild}}</text>
            </view>
            <view class="career-rec-meta">
              <text class="career-rec-path">→ {{item.careerPath}}</text>
              <text class="career-rec-schools" wx:if="{{item.schoolExamples}}">参考院校：{{item.schoolExamples}}</text>
            </view>
          </view>
        </view>

        <!-- 路径推荐理由 -->
        <view class="ai-path-reason-card" wx:if="{{aiFullReport.pathReasoning}}">
          <text class="ai-path-reason-label">→ 为什么推荐这条路径？</text>
          <text class="ai-path-reason-text">{{aiFullReport.pathReasoning}}</text>
        </view>

        <!-- 本周最优先行动 -->
        <view class="ai-top-action-card" wx:if="{{aiFullReport.topPriorityAction}}">
          <text class="ai-top-action-label">✦ 本周最重要的一件事</text>
          <text class="ai-top-action-text">{{aiFullReport.topPriorityAction}}</text>
        </view>

        <!-- 袁希结语 -->
        <view class="ai-signature-card" wx:if="{{aiFullReport.yuanxiSignature}}">
          <text class="ai-signature-mark">✦</text>
          <text class="ai-signature-text">{{aiFullReport.yuanxiSignature}}</text>
        </view>

      </view>
    </view>

    <!-- ── SECTION 6：院校参考（冲刺/目标/稳妥三层客观推荐）── -->
    <view class="section-card school-rec-section" wx:if="{{schoolRecs}}" bindtap="toggleSection" data-section="schools">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-num">06</text>
          <text class="section-title">院校参考</text>
          <view class="school-rec-badge"><text>基于真实匹配</text></view>
        </view>
        <text class="section-arrow">{{expandedSection === 'schools' ? '▲' : '▼'}}</text>
      </view>

      <view class="section-body school-rec-body" wx:if="{{expandedSection === 'schools'}}">

        <!-- 算法说明 -->
        <view class="school-algo-note">
          <text class="school-algo-icon">≡</text>
          <text class="school-algo-text">根据{{schoolRecs.academicTierLabel}}，结合路径偏好和家庭预算，客观计算匹配度。不推荐不切实际的学校。</text>
        </view>

        <!-- 地理偏好执行说明：告诉用户我们是否匹配到了他们想要的国家/地区 -->
        <view wx:if="{{schoolRecs.geoPrefNote}}"
              class="geo-pref-note geo-pref-{{schoolRecs.geoPrefNote.type}}">
          <text class="geo-pref-note-icon">
