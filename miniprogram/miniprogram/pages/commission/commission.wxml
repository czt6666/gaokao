<!-- pages/commission/commission.wxml -->
<view class="page">
  <!-- 顶部卡片 -->
  <view class="header-card">
    <view class="title-row">
      <text class="title">我的收益</text>
    </view>
    <view class="stats">
      <view class="stat-item">
        <text class="stat-value green">¥{{balanceYuan}}</text>
        <text class="stat-label">可提现</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">¥{{pendingYuan}}</text>
        <text class="stat-label">冻结中</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">¥{{totalEarnedYuan}}</text>
        <text class="stat-label">累计收益</text>
      </view>
    </view>
  </view>

  <!-- 提现按钮 -->
  <view class="withdraw-bar">
    <button
      class="withdraw-btn {{balanceFen >= 10000 ? '' : 'disabled'}}"
      bindtap="onWithdraw"
      disabled="{{balanceFen < 10000}}"
    >
      {{balanceFen >= 10000 ? '申请提现' : '满 ¥100 可提现'}}
    </button>
  </view>

  <!-- 收益明细 -->
  <view class="section">
    <view class="section-title">收益明细</view>
    <view wx:if="{{records.length === 0}}" class="empty">暂无收益记录</view>
    <view wx:for="{{records}}" wx:key="id" class="record-row">
      <view class="record-left">
        <text class="record-order">订单 {{item.order_no ? item.order_no.slice(-6) : '--'}}</text>
        <text class="record-status">{{item.status === 'frozen' ? '冻结中' : item.status === 'available' ? '已到账' : item.status === 'deducted' ? '已扣除' : item.status}}</text>
      </view>
      <view class="record-right">
        <text class="record-amount {{item.status === 'deducted' ? 'red' : 'green'}}">{{item.status === 'deducted' ? '-' : '+'}}¥{{item.amount_yuan}}</text>
      </view>
    </view>
  </view>

  <!-- 提现弹窗 -->
  <view wx:if="{{showWithdrawModal}}" class="modal-mask" bindtap="onCloseModal">
    <view class="modal-content" catchtap="stopBubble">
      <view class="modal-title">申请提现</view>
      <view class="modal-body">
        <view class="modal-tip">
          1. 添加客服微信：<text class="strong" bindtap="onCopyWechat">shuilukefu</text>（点击复制）
        </view>
        <view class="modal-tip">2. 备注您的用户 ID，审核通过后微信转账</view>
        <view class="modal-balance">
          <text class="modal-balance-label">可提现余额</text>
          <text class="modal-balance-value">¥{{balanceYuan}}</text>
        </view>
        <text wx:if="{{withdrawMsg}}" class="modal-msg {{withdrawMsg.includes('成功') ? 'green' : 'red'}}">{{withdrawMsg}}</text>
      </view>
      <view class="modal-actions">
        <button
          class="modal-btn primary"
          bindtap="onConfirmWithdraw"
          loading="{{withdrawLoading}}"
          disabled="{{withdrawLoading}}"
        >确认申请</button>
        <button
          class="modal-btn ghost"
          bindtap="onCloseModal"
          disabled="{{withdrawLoading}}"
        >取消</button>
      </view>
    </view>
  </view>
</view>
